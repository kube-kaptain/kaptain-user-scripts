# Kaptain decrypt router - auto-detects encryption type and delegates
#
# Usage: kaptain-decrypt [--type TYPE] [--dir DIR]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Parse arguments - consume --type, pass everything else through
TYPE=""
DIR="${KAPTAIN_USER_SCRIPTS_SECRETS_DIR:-src/secrets}"
PASSTHROUGH=()

usage() {
  echo "Usage: kaptain decrypt [--type TYPE] [--dir DIR]"
  echo ""
  echo "Options:"
  echo "  --type TYPE   Encryption type (auto-detected if omitted)"
  echo "  --dir DIR     Target directory (default: src/secrets)"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --type requires a value" >&2
        usage >&2
        exit 1
      fi
      TYPE="$2"
      shift 2
      ;;
    --dir)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --dir requires a value" >&2
        usage >&2
        exit 1
      fi
      DIR="$2"
      PASSTHROUGH+=("$1" "$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# Reject absolute paths
if [[ "${DIR}" == /* ]]; then
  echo "ERROR: --dir must be a relative path, i.e. a sub path of this repo" >&2
  exit 1
fi

if [[ ! -d "${DIR}" ]]; then
  echo "ERROR: Directory not found: ${DIR}" >&2
  exit 1
fi

# Check gitignore configuration before proceeding
"${SCRIPT_DIR}/kaptain-encryption-check-ignores" --dir "${DIR}"

# Supported types and directory detection both come from the shared helper
DETECT_TYPE="${SCRIPT_DIR}/kaptain-encryption-detect-type"

SUPPORTED_TYPES=()
while IFS= read -r suffix; do
  SUPPORTED_TYPES+=("${suffix}")
done < <("${DETECT_TYPE}" --list)

if [[ ${#SUPPORTED_TYPES[@]} -eq 0 ]]; then
  echo "ERROR: No decrypt scripts found in ${SCRIPT_DIR}" >&2
  exit 1
fi

# Check if type is supported
is_supported_type() {
  local check_type="$1"
  local t
  for t in ${SUPPORTED_TYPES[@]+"${SUPPORTED_TYPES[@]}"}; do
    if [[ "${t}" == "${check_type}" ]]; then
      return 0
    fi
  done
  return 1
}

# Determine type
if [[ -z "${TYPE}" ]]; then
  TYPE=$("${DETECT_TYPE}" --dir "${DIR}")
  echo "Auto-detected type: ${TYPE}"
fi

# Validate type
if ! is_supported_type "${TYPE}"; then
  echo "ERROR: Unsupported encryption type: ${TYPE}" >&2
  echo "Supported types: ${SUPPORTED_TYPES[*]}" >&2
  exit 1
fi

# Delegate to specific script
DECRYPT_SCRIPT="${SCRIPT_DIR}/kaptain-decrypt-${TYPE}"

if [[ ! -x "${DECRYPT_SCRIPT}" ]]; then
  echo "ERROR: Decrypt script not found: ${DECRYPT_SCRIPT}" >&2
  exit 1
fi

exec "${DECRYPT_SCRIPT}" ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
