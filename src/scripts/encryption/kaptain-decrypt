#
# Kaptain decrypt router - auto-detects encryption type and delegates
#
# Usage: kaptain-decrypt [--type TYPE] [--dir DIR]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Parse arguments - consume --type, pass everything else through
TYPE=""
DIR="${KAPTAIN_USER_SCRIPTS_SECRETS_DIR:-src/secrets}"
SHOW=false
WANT_TOKEN=""
PASSTHROUGH=()

usage() {
  echo "Usage: kaptain decrypt [--type TYPE] [--dir DIR]"
  echo "       kaptain decrypt --show [TOKEN_NAME] [--dir DIR]"
  echo ""
  echo "Options:"
  echo "  --type TYPE   Encryption type (auto-detected if omitted)"
  echo "  --dir DIR     Target directory (default: src/secrets)"
  echo "  --show        Display token values instead of writing .txt files."
  echo "                Nothing is written to disk. Name one token to print"
  echo "                just its value, whole, however many lines it has."
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --type requires a value" >&2
        usage >&2
        exit 1
      fi
      TYPE="$2"
      shift 2
      ;;
    --dir)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --dir requires a value" >&2
        usage >&2
        exit 1
      fi
      DIR="$2"
      PASSTHROUGH+=("$1" "$2")
      shift 2
      ;;
    --show)
      SHOW=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      # A single bare argument is the token name to show
      if [[ -n "${WANT_TOKEN}" ]]; then
        echo "ERROR: Only one token name may be given: ${WANT_TOKEN}, $1" >&2
        exit 1
      fi
      WANT_TOKEN="$1"
      shift
      ;;
  esac
done

if [[ -n "${WANT_TOKEN}" && "${SHOW}" == "false" ]]; then
  echo "ERROR: A token name only means something with --show: ${WANT_TOKEN}" >&2
  usage >&2
  exit 1
fi

if [[ "${SHOW}" == "true" && -n "${TYPE}" ]]; then
  echo "ERROR: --type cannot be combined with --show, the type is detected" >&2
  exit 1
fi

# Reject absolute paths
if [[ "${DIR}" == /* ]]; then
  echo "ERROR: --dir must be a relative path, i.e. a sub path of this repo" >&2
  exit 1
fi

if [[ ! -d "${DIR}" ]]; then
  echo "ERROR: Directory not found: ${DIR}" >&2
  exit 1
fi

# Showing values writes nothing, so it is a straight alias for the list view,
# which owns the formatting. The gitignore check below is about files landing
# on disk and has nothing to check here.
if [[ "${SHOW}" == "true" ]]; then
  if [[ -n "${WANT_TOKEN}" ]]; then
    exec "${SCRIPT_DIR}/kaptain-list-secrets" --dir "${DIR}" --decrypt "${WANT_TOKEN}"
  fi
  exec "${SCRIPT_DIR}/kaptain-list-secrets" --dir "${DIR}" --decrypt
fi

# Check gitignore configuration before proceeding
"${SCRIPT_DIR}/kaptain-encryption-check-ignores" --dir "${DIR}"

# Supported types and directory detection both come from the shared helper
DETECT_TYPE="${SCRIPT_DIR}/kaptain-encryption-detect-type"

SUPPORTED_TYPES=()
while IFS= read -r suffix; do
  SUPPORTED_TYPES+=("${suffix}")
done < <("${DETECT_TYPE}" --list)

if [[ ${#SUPPORTED_TYPES[@]} -eq 0 ]]; then
  echo "ERROR: No decrypt scripts found in ${SCRIPT_DIR}" >&2
  exit 1
fi

# Check if type is supported
is_supported_type() {
  local check_type="$1"
  local t
  for t in ${SUPPORTED_TYPES[@]+"${SUPPORTED_TYPES[@]}"}; do
    if [[ "${t}" == "${check_type}" ]]; then
      return 0
    fi
  done
  return 1
}

# Determine type
if [[ -z "${TYPE}" ]]; then
  TYPE=$("${DETECT_TYPE}" --dir "${DIR}")
  echo "Auto-detected type: ${TYPE}"
fi

# Validate type
if ! is_supported_type "${TYPE}"; then
  echo "ERROR: Unsupported encryption type: ${TYPE}" >&2
  echo "Supported types: ${SUPPORTED_TYPES[*]}" >&2
  exit 1
fi

# Delegate to specific script
DECRYPT_SCRIPT="${SCRIPT_DIR}/kaptain-decrypt-${TYPE}"

if [[ ! -x "${DECRYPT_SCRIPT}" ]]; then
  echo "ERROR: Decrypt script not found: ${DECRYPT_SCRIPT}" >&2
  exit 1
fi

exec "${DECRYPT_SCRIPT}" ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
