ask_section_13_claude() {
  say_section "13. Claude Code + plugins"
  if ask_yn "Install the claude-code cask?" "y"; then
    DO_CLAUDE_CODE=true
    plan_casks claude-code
    say_blank
    cat <<'EOF'
Recommended Kaptain set:
  Marketplaces: Branchout/branchout-marketplace,
                kube-kaptain/kaptain-marketplace,
                obra/superpowers-marketplace
  Plugins:      branchout-skills,
                superpowers,
                elements-of-style
EOF
    if ask_yn "Install recommended marketplaces and plugins?" "y"; then
      DO_CLAUDE_PLUGINS=true
      local m p
      for m in Branchout/branchout-marketplace kube-kaptain/kaptain-marketplace obra/superpowers-marketplace; do
        if ! claude_marketplace_present "${m}"; then
          CLAUDE_MARKETPLACES_TO_ADD=$(list_add "${m}" "${CLAUDE_MARKETPLACES_TO_ADD}")
        fi
      done
      for p in branchout-skills@branchout-marketplace superpowers@superpowers-marketplace elements-of-style@superpowers-marketplace; do
        if ! claude_plugin_present "${p}"; then
          CLAUDE_PLUGINS_TO_INSTALL=$(list_add "${p}" "${CLAUDE_PLUGINS_TO_INSTALL}")
        fi
      done
    else
      DO_CLAUDE_PLUGINS=false
    fi
  else
    DO_CLAUDE_CODE=false
    DO_CLAUDE_PLUGINS=false
  fi
}

