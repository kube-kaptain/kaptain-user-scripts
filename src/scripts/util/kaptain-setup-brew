  if command -v kdiff3 >/dev/null 2>&1; then
    DO_KDIFF3=false
    say "kdiff3 is already on your PATH at: $(command -v kdiff3)"
    say "Skipping install and PATH addition."
    return
  fi
  cat <<'EOF'
Optional 3-way diff/merge GUI. If installed, the kdiff3 binary path is added
to your PATH via the managed profile block.
EOF
  say_blank
  if ask_yn "Install kdiff3?" "y"; then
    DO_KDIFF3=true
    plan_casks kdiff3
  else
    DO_KDIFF3=false
  fi
}

ask_section_10_bash_completion() {
  say_section "10. bash-completion"
  if [[ "${SHELL_KIND}" != "bash" ]]; then
    say "Skipped: your shell is not bash."
    DO_BASH_COMPLETION=false
    return
  fi
  cat <<EOF
Tab-completion for kaptain and other CLIs. Detected bash major version
${BASH_MAJOR}, would install: ${BASH_COMPLETION_PKG}
EOF
  say_blank
  if ask_yn "Install bash-completion?" "y"; then
