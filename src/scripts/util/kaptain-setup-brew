#
# Interactive Homebrew setup for Kaptain users on macOS (or Linux with brew).
# Walks the user through suggest-ask-remember prompts, prints a plan, confirms
# once, then executes.
#
# Usage: kaptain setup brew [--copy-fred] [--apps-in-home] [-h|--help]

set -euo pipefail

# Decision-tracking variables (DO_CORE, DO_HELM, etc.) are assigned per ask
# for clarity even when only the plan_formulae/plan_casks side-effect is read
# later. Suppress unused-variable warnings for these.
# shellcheck disable=SC2034

# Flags
COPY_FRED=false
APPS_IN_HOME=false

# Snapshots
FORMULAE_INSTALLED=""
CASKS_INSTALLED=""

# Plan accumulators (space-separated for bash 3.2 friendliness)
FORMULAE_TO_INSTALL=""
CASKS_TO_INSTALL=""
FORMULAE_SKIPPED=""
CASKS_SKIPPED=""

# Profile block lines (indexed array)
PROFILE_LINES=()

# Decisions populated by ask_* functions
APPS_TO_HOME=false
DO_PROFILE_BLOCK=true
DO_CORE=true
DO_BRANCHOUT=true
DO_BUILD_SCRIPTS=true
NEEDS_BUILD_CLONE=false
DO_HELM=true
DO_SHELL_DEV=false
DO_GITG=false
DO_KDIFF3=false
DO_BASH_COMPLETION=true
RUNTIME_CHOICE="none"
PODMAN_ROOTFUL=true
PODMAN_DESKTOP=true
PODMAN_NEEDS_MACHINE_SETUP=false
BUILD_SCRIPTS_PATH=""
CLAUDE_MARKETPLACES_LIST=""
CLAUDE_PLUGINS_LIST=""
CLAUDE_MARKETPLACES_TO_ADD=""
CLAUDE_PLUGINS_TO_INSTALL=""
DO_GH=true
DO_CLAUDE_CODE=true
DO_CLAUDE_PLUGINS=true
DO_TESSL=false
DO_SNYK=false

# Detected
SHELL_KIND="other"
PROFILE_FILE=""
BASH_MAJOR=0
BASH_COMPLETION_PKG=""

usage() {
  cat <<'EOF'
Usage: kaptain setup brew [--copy-fred] [--apps-in-home] [-h|--help]

Interactive Homebrew setup for Kaptain users. Walks through suggest-ask-remember
prompts grouped by purpose, prints a plan, confirms once, then executes.

Options:
  --copy-fred     Accept the default answer for every prompt that has a default.
                  Does not answer the apps-location prompt (section 1), which
                  always requires an explicit choice unless --apps-in-home is
                  also passed.
  --apps-in-home  Use ~/Applications for cask installs (sets HOMEBREW_CASK_OPTS).
                  Skips the apps-location prompt.
  -h, --help      Show this help.
EOF
}

# Parse flags
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --copy-fred)
      COPY_FRED=true
      shift
      ;;
    --apps-in-home)
      APPS_IN_HOME=true
      shift
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# ---------- helpers ----------

say() { printf '%s\n' "$@"; }
say_blank() { echo ""; }

say_section() {
  echo ""
  echo "=== $1 ==="
  echo ""
}

list_contains() {
  local needle="$1"
  local haystack="$2"
  case " ${haystack} " in
    *" ${needle} "*) return 0 ;;
    *) return 1 ;;
  esac
}

list_add() {
  local val="$1"
  local list="$2"
  if [[ -z "${list}" ]]; then
    printf '%s' "${val}"
  else
    printf '%s %s' "${list}" "${val}"
  fi
}

# ask_yn PROMPT DEFAULT [COPY_FRED_ANSWER]
# DEFAULT is y or n. Returns 0 for yes, 1 for no.
# Under --copy-fred, returns COPY_FRED_ANSWER if given, otherwise DEFAULT.
# Use the override for prompts where the interactive default should be n but
# Fred's setup wants y (e.g. shell-dev tooling).
ask_yn() {
  local prompt="$1"
  local default="$2"
  local copy_fred_answer="${3:-${default}}"
  local marker
  if [[ "${default}" == "y" ]]; then
    marker="[Y/n]"
  else
    marker="[y/N]"
  fi

  if [[ "${COPY_FRED}" == "true" ]]; then
    say "${prompt} ${marker} ${copy_fred_answer} (auto via --copy-fred)"
    if [[ "${copy_fred_answer}" == "y" ]]; then
      return 0
    fi
    return 1
  fi

  local answer=""
  read -r -p "${prompt} ${marker} " answer
  if [[ -z "${answer}" ]]; then
    answer="${default}"
  fi
  case "${answer}" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

# ask_required_yn PROMPT
# Re-prompts until valid y or n. Never auto-answered.
ask_required_yn() {
  local prompt="$1"
  local answer=""
  while :; do
    read -r -p "${prompt} [y/n] " answer
    case "${answer}" in
      y|Y|yes|YES|Yes) return 0 ;;
      n|N|no|NO|No) return 1 ;;
      *) echo "Please answer y or n." ;;
    esac
  done
}

# ask_menu PROMPT DEFAULT_INDEX OPTION1 OPTION2 ...
# Echoes the selected index (1-based) to stdout.
# Under --copy-fred, returns DEFAULT_INDEX without prompting.
# All UI output goes to stderr so the caller can capture only the answer via $().
ask_menu() {
  local prompt="$1"
  local default_index="$2"
  shift 2
  local options=("$@")
  local n=${#options[@]}

  echo "" >&2
  printf '%s\n' "${prompt}" >&2
  local i=1
  for opt in "${options[@]}"; do
    printf '  %d) %s\n' "${i}" "${opt}" >&2
    i=$((i + 1))
  done

  if [[ "${COPY_FRED}" == "true" ]]; then
    printf '[%s] %s (auto via --copy-fred)\n' "${default_index}" "${default_index}" >&2
    echo "${default_index}"
    return
  fi

  local answer=""
  while :; do
    read -r -p "[${default_index}] " answer
    if [[ -z "${answer}" ]]; then
      answer="${default_index}"
    fi
    if [[ "${answer}" =~ ^[0-9]+$ ]] && (( answer >= 1 )) && (( answer <= n )); then
      echo "${answer}"
      return
    fi
    echo "Please pick a number between 1 and ${n}." >&2
  done
}

# ---------- preflight ----------

preflight() {
  if ! command -v brew >/dev/null 2>&1; then
    cat >&2 <<'EOF'
ERROR: Homebrew (brew) is not installed.

Install it with:

  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

Then re-run this script.
EOF
    exit 1
  fi

  detect_caller_shell
  resolve_profile_file
  detect_bash_version
  snapshot_installed
}

# Detect the shell that invoked this script. Because the kaptain and
# kaptain-setup routers both use exec rather than fork, $PPID points to the
# user's actual interactive shell, not an intermediate wrapper. This is more
# accurate than $SHELL, which can be stale if the user has not run chsh.
detect_caller_shell() {
  local pcomm=""
  pcomm=$(ps -p "$PPID" -o comm= 2>/dev/null | tr -d ' ' || true)
  pcomm="${pcomm#-}"        # strip leading dash for login shells (-bash, -zsh)
  pcomm="${pcomm##*/}"      # strip any leading path
  case "${pcomm}" in
    bash) SHELL_KIND="bash"; return ;;
    zsh)  SHELL_KIND="zsh";  return ;;
  esac
  # Fallback to $SHELL if the parent process name was unrecognised
  case "${SHELL:-}" in
    */bash) SHELL_KIND="bash" ;;
    */zsh) SHELL_KIND="zsh" ;;
    *) SHELL_KIND="other" ;;
  esac
}

resolve_profile_file() {
  local candidates=""
  case "${SHELL_KIND}" in
    bash) candidates="${HOME}/.bash_profile ${HOME}/.profile" ;;
    zsh) candidates="${HOME}/.zshrc ${HOME}/.zprofile ${HOME}/.profile" ;;
    *) candidates="${HOME}/.profile" ;;
  esac

  local existing=""
  local c
  for c in ${candidates}; do
    if [[ -f "${c}" ]]; then
      existing="${existing} ${c}"
    fi
  done
  existing="${existing# }"

  if [[ -z "${existing}" ]]; then
    PROFILE_FILE="${candidates%% *}"
    return
  fi

  local count=0
  for c in ${existing}; do
    count=$((count + 1))
  done

  if [[ ${count} -eq 1 ]]; then
    PROFILE_FILE="${existing}"
    return
  fi

  # Multiple candidates - ask
  say_blank
  say "Multiple shell profile files exist. Which should I write to?"
  local i=1
  local first=""
  for c in ${existing}; do
    say "  ${i}) ${c}"
    if [[ -z "${first}" ]]; then
      first="${c}"
    fi
    i=$((i + 1))
  done

  if [[ "${COPY_FRED}" == "true" ]]; then
    PROFILE_FILE="${first}"
    say "[1] 1 (auto via --copy-fred)"
    return
  fi

  local answer=""
  while :; do
    read -r -p "[1] " answer
    if [[ -z "${answer}" ]]; then
      answer=1
    fi
    if [[ "${answer}" =~ ^[0-9]+$ ]] && (( answer >= 1 )) && (( answer <= count )); then
      break
    fi
    say "Please pick a number between 1 and ${count}."
  done

  i=1
  for c in ${existing}; do
    if [[ "${i}" == "${answer}" ]]; then
      PROFILE_FILE="${c}"
      return
    fi
    i=$((i + 1))
  done
  PROFILE_FILE="${first}"
}

detect_bash_version() {
  # This script's shebang is bash, so $BASH_VERSION is always set and reflects
  # the bash actually executing the script. That is the right reference point
  # for picking bash-completion vs bash-completion@2 (@2 requires bash 4.1+).
  if [[ -n "${BASH_VERSION:-}" ]]; then
    BASH_MAJOR="${BASH_VERSION%%.*}"
  fi
  if (( BASH_MAJOR >= 4 )); then
    BASH_COMPLETION_PKG="bash-completion@2"
  else
    BASH_COMPLETION_PKG="bash-completion"
  fi
}

snapshot_installed() {
  # 'brew list --formula' lists every installed formula including ones pulled
  # in as dependencies. Using 'brew leaves --installed-on-request' would miss
  # formulae like podman when something like podman-compose depends on it.
  FORMULAE_INSTALLED=$(brew list --formula 2>/dev/null | tr '\n' ' ' || true)
  CASKS_INSTALLED=$(brew list --cask 2>/dev/null | tr '\n' ' ' || true)
  if command -v claude >/dev/null 2>&1; then
    CLAUDE_MARKETPLACES_LIST=$(claude plugin marketplace list 2>/dev/null || true)
    CLAUDE_PLUGINS_LIST=$(claude plugin list 2>/dev/null || true)
  fi
}

# Substring search in claude's multi-line list output. The marketplace 'list'
# command prints Source: GitHub (Org/repo-name) lines, which contain the full
# org/repo string we use with 'marketplace add'. Plugin list prints
# 'name@marketplace' literally. Substring match handles both.
claude_marketplace_present() {
  case "${CLAUDE_MARKETPLACES_LIST}" in
    *"$1"*) return 0 ;;
    *) return 1 ;;
  esac
}

claude_plugin_present() {
  case "${CLAUDE_PLUGINS_LIST}" in
    *"$1"*) return 0 ;;
    *) return 1 ;;
  esac
}

# plan_formulae PKG [PKG...]
# Each PKG can be plain name or tap-qualified (e.g. tesslio/tap/tessl).
# brew leaves may emit either form for tap-qualified packages, so match both.
plan_formulae() {
  local pkg short
  for pkg in "$@"; do
    short="${pkg##*/}"
    if list_contains "${pkg}" "${FORMULAE_INSTALLED}" \
        || list_contains "${short}" "${FORMULAE_INSTALLED}"; then
      FORMULAE_SKIPPED=$(list_add "${pkg}" "${FORMULAE_SKIPPED}")
    else
      FORMULAE_TO_INSTALL=$(list_add "${pkg}" "${FORMULAE_TO_INSTALL}")
    fi
  done
}

plan_casks() {
  local pkg
  for pkg in "$@"; do
    if list_contains "${pkg}" "${CASKS_INSTALLED}"; then
      CASKS_SKIPPED=$(list_add "${pkg}" "${CASKS_SKIPPED}")
    else
      CASKS_TO_INSTALL=$(list_add "${pkg}" "${CASKS_TO_INSTALL}")
    fi
  done
}

# ---------- asks ----------

ask_section_1_apps() {
  say_section "1. Apps install location"
  if [[ "${APPS_IN_HOME}" == "true" ]]; then
    APPS_TO_HOME=true
    say "Using ~/Applications (via --apps-in-home flag)."
    return
  fi
  if [[ "${COPY_FRED}" == "true" ]]; then
    APPS_TO_HOME=false
    say "Leaving brew default /Applications in place (--copy-fred skips this prompt)."
    return
  fi
  cat <<'EOF'
Sets HOMEBREW_CASK_OPTS=--appdir=$HOME/Applications, which sends future cask
installs to ~/Applications instead of /Applications.

On corporate machines under MDM, writes to /Applications often require admin
rights, which can make 'brew install --cask ...' fail. Installing into your
home directory sidesteps that and lets the install succeed.

Whether the app then runs is a separate question. MDM policies on app
notarisation, gatekeeper, or executable signing can still block launch from
any location. This setting only changes the install destination, not the
run-time permissions.
EOF
  say_blank
  if ask_required_yn "Use ~/Applications for cask installs?"; then
    APPS_TO_HOME=true
  else
    APPS_TO_HOME=false
  fi
}

ask_section_2_profile() {
  say_section "2. Managed profile block"
  cat <<EOF
Adds homebrew quiet settings, bash deprecation silence (if bash), and a safe
bash_completion source line. Written as a marked, idempotent block in:
  ${PROFILE_FILE}
EOF
  say_blank
  if ask_yn "Write managed profile block?" "y"; then
    DO_PROFILE_BLOCK=true
  else
    DO_PROFILE_BLOCK=false
  fi
}

ask_section_3_core() {
  say_section "3. Core packages (required to build Kaptain projects)"
  cat <<'EOF'
These packages are required to build Kaptain projects locally. Only skip if
you provide them another way or do not need to build Kaptain projects locally.

  yq, jq, check-jsonschema, skopeo
EOF
  say_blank
  if ask_yn "Install core packages?" "y"; then
    DO_CORE=true
    plan_formulae yq jq check-jsonschema skopeo
  else
    DO_CORE=false
  fi
}

ask_section_4_branchout() {
  say_section "4. Branchout"
  cat <<'EOF'
Manage branchout repo trees under ~/projects/. Recommended.
EOF
  say_blank
  if ask_yn "Install Branchout?" "y"; then
    DO_BRANCHOUT=true
    plan_formulae branchout/branchout/branchout
  else
    DO_BRANCHOUT=false
  fi
}

ask_section_5_build_scripts() {
  say_section "5. Local kaptain build scripts"

  # Honour an existing env var so we never override the user's chosen layout.
  if [[ -n "${KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT:-}" ]]; then
    BUILD_SCRIPTS_PATH="${KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT}"
  else
    BUILD_SCRIPTS_PATH="${HOME}/projects/kaptain/buildon/buildon-github-actions"
  fi

  # If the target dir is already present, no clone is needed and no prompt is
  # warranted. The profile var still gets written so future shells have it.
  if [[ -d "${BUILD_SCRIPTS_PATH}" ]]; then
    DO_BUILD_SCRIPTS=true
    NEEDS_BUILD_CLONE=false
    say "Build scripts already present at: ${BUILD_SCRIPTS_PATH}"
    say "Skipping clone. Profile var will still be written to ensure it is set."
    return
  fi

  cat <<EOF
Enables 'kaptain build local' by placing the build scripts at
  ${BUILD_SCRIPTS_PATH}
and writing KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT to your profile.
EOF
  say_blank
  if ask_yn "Set up local kaptain build scripts?" "y"; then
    DO_BUILD_SCRIPTS=true
    NEEDS_BUILD_CLONE=true
  else
    DO_BUILD_SCRIPTS=false
    NEEDS_BUILD_CLONE=false
  fi
}

ask_section_6_helm() {
  say_section "6. Helm"
  cat <<'EOF'
Needed for local builds of vendor helm repackage projects. Recommended.
EOF
  say_blank
  if ask_yn "Install helm?" "y"; then
    DO_HELM=true
