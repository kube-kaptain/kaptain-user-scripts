  fi
}

ask_section_11_runtime() {
  say_section "11. Container runtime"
  local choice
  choice=$(ask_menu "Pick a container runtime:" 1 \
    "Podman          (no-socket, lightweight, no built-in kube)" \
    "Rancher Desktop (heavier, includes kube)" \
    "Colima          (lightweight, no built-in kube)" \
    "Docker Desktop  (commercial license may apply)" \
    "None            (I already have one or do not need one)")
  case "${choice}" in
    1) RUNTIME_CHOICE="podman" ;;
    2) RUNTIME_CHOICE="rancher" ;;
    3) RUNTIME_CHOICE="colima" ;;
    4) RUNTIME_CHOICE="docker" ;;
    5) RUNTIME_CHOICE="none" ;;
  esac

  case "${RUNTIME_CHOICE}" in
    podman)
      plan_formulae podman podman-compose
      if list_contains "podman" "${FORMULAE_INSTALLED}"; then
        PODMAN_NEEDS_MACHINE_SETUP=false
        say_blank
        say "Podman is already installed. Assuming the machine is already configured;"
        say "skipping init/rootful prompts and steps."
      else
        PODMAN_NEEDS_MACHINE_SETUP=true
        say_blank
        cat <<'EOF'
Run podman as root in the VM? Necessary for some applications; trade-off:
containers within the VM can run with elevated privileges. Press Enter for
yes; type 'n' + Enter for no.
EOF
        if ask_yn "Use rootful podman?" "y"; then
          PODMAN_ROOTFUL=true
        else
          PODMAN_ROOTFUL=false
        fi
      fi
      say_blank
      if ask_yn "Install Podman Desktop GUI?" "y"; then
        PODMAN_DESKTOP=true
        plan_casks podman-desktop
      else
        PODMAN_DESKTOP=false
      fi
      ;;
    rancher)
      plan_casks rancher
      say_blank
      say "Note: Rancher Desktop post-install steps (start, kube enable) are left to you."
      ;;
    colima)
      plan_formulae colima
      say_blank
      say "Note: 'colima start' is left to you after install."
      ;;
    docker)
      plan_casks docker
      say_blank
      say "Note: launching Docker Desktop and accepting its license is left to you."
      ;;
    none)
      say "Skipping container runtime install."
      ;;
  esac
}

