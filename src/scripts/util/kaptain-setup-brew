# ---------- profile block builder ----------

# Returns 0 if the profile file already contains the given substring on a line
# OUTSIDE our managed block. Used to avoid duplicating exports the user already
# set themselves.
profile_contains_outside_block() {
  local file="$1"
  local needle="$2"
  if [[ ! -f "${file}" ]]; then
    return 1
  fi
  awk -v begin="# BEGIN kaptain-setup-brew managed block" \
      -v end="# END kaptain-setup-brew managed block" '
    $0 == begin { in_block = 1; next }
    $0 == end   { in_block = 0; next }
    !in_block { print }
  ' "${file}" | grep -qF "${needle}"
}

# add_profile_line NEEDLE LINE — appends LINE to PROFILE_LINES only if NEEDLE
# is not already present in the profile outside our managed block.
add_profile_line() {
  local needle="$1"
  local line="$2"
  if profile_contains_outside_block "${PROFILE_FILE}" "${needle}"; then
    echo "  (Skipping '${needle}' - already set in ${PROFILE_FILE})" >&2
    return
  fi
  PROFILE_LINES+=("${line}")
}

build_profile_lines() {
  PROFILE_LINES=()
  if [[ "${DO_PROFILE_BLOCK}" != "true" ]]; then
    return
  fi
  add_profile_line "HOMEBREW_NO_AUTO_UPDATE" \
    "export HOMEBREW_NO_AUTO_UPDATE=1"
  add_profile_line "HOMEBREW_NO_INSTALL_CLEANUP" \
    "export HOMEBREW_NO_INSTALL_CLEANUP=1"
  if [[ "${SHELL_KIND}" == "bash" ]]; then
    add_profile_line "BASH_SILENCE_DEPRECATION_WARNING" \
      "export BASH_SILENCE_DEPRECATION_WARNING=1"
  fi
  if [[ "${APPS_TO_HOME}" == "true" ]]; then
    add_profile_line "HOMEBREW_CASK_OPTS" \
      "export HOMEBREW_CASK_OPTS=\"--appdir=\${HOME}/Applications\""
  fi
  if [[ "${DO_BUILD_SCRIPTS}" == "true" ]]; then
    # Write the resolved BUILD_SCRIPTS_PATH literally so the profile keeps the
    # exact location the user already has, even if it is not the default.
    add_profile_line "KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT" \
      "export KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT=\"${BUILD_SCRIPTS_PATH}\""
  fi
  if [[ "${DO_KDIFF3}" == "true" ]]; then
    if [[ "${APPS_TO_HOME}" == "true" ]]; then
      add_profile_line "kdiff3.app/Contents/MacOS" \
        "export PATH=\"\${PATH}:\${HOME}/Applications/kdiff3.app/Contents/MacOS\""
    else
      add_profile_line "kdiff3.app/Contents/MacOS" \
        "export PATH=\"\${PATH}:/Applications/kdiff3.app/Contents/MacOS\""
    fi
  fi
  if [[ "${DO_BASH_COMPLETION}" == "true" && "${SHELL_KIND}" == "bash" ]]; then
    add_profile_line "bash_completion.sh" \
      "[[ -r \"\$(brew --prefix)/etc/profile.d/bash_completion.sh\" ]] && . \"\$(brew --prefix)/etc/profile.d/bash_completion.sh\""
  fi
}

write_managed_block() {
  local file="$1"
  shift
  local begin="# BEGIN kaptain-setup-brew managed block"
  local end="# END kaptain-setup-brew managed block"

  touch "${file}"
  local tmpfile
  tmpfile=$(mktemp)

  awk -v begin="${begin}" -v end="${end}" '
    $0 == begin { in_block = 1; next }
    $0 == end   { in_block = 0; next }
    !in_block { print }
  ' "${file}" > "${tmpfile}"

  {
    cat "${tmpfile}"
    echo "${begin}"
    if [[ $# -gt 0 ]]; then
      local line
      for line in "$@"; do
        echo "${line}"
      done
    fi
    echo "${end}"
  } > "${file}"

  rm -f "${tmpfile}"
}

# ---------- plan printing ----------

print_plan() {
  echo ""
  echo "================================================================"
  echo "PLAN"
  echo "================================================================"
  echo ""

  if [[ -n "${FORMULAE_TO_INSTALL}" ]]; then
    echo "Brew install (formulae):"
    echo "  ${FORMULAE_TO_INSTALL}"
  fi
  if [[ -n "${FORMULAE_SKIPPED}" ]]; then
    echo "  Already installed, will skip: ${FORMULAE_SKIPPED}"
  fi
  if [[ -n "${FORMULAE_TO_INSTALL}" || -n "${FORMULAE_SKIPPED}" ]]; then
    echo ""
  fi

  if [[ -n "${CASKS_TO_INSTALL}" ]]; then
    echo "Brew install (casks):"
    echo "  ${CASKS_TO_INSTALL}"
  fi
  if [[ -n "${CASKS_SKIPPED}" ]]; then
    echo "  Already installed, will skip: ${CASKS_SKIPPED}"
  fi
  if [[ -n "${CASKS_TO_INSTALL}" || -n "${CASKS_SKIPPED}" ]]; then
    echo ""
  fi

  if [[ "${RUNTIME_CHOICE}" == "podman" && "${PODMAN_NEEDS_MACHINE_SETUP}" == "true" ]]; then
    echo "Container runtime setup (podman):"
    echo "  podman machine init"
    echo "  podman machine start"
    if [[ "${PODMAN_ROOTFUL}" == "true" ]]; then
      echo "  podman machine stop"
      echo "  podman machine set --rootful"
      echo "  podman machine start"
    fi
    echo ""
  fi

  if [[ "${NEEDS_BUILD_CLONE}" == "true" ]]; then
    echo "Kaptain build scripts:"
    echo "  Target: ${BUILD_SCRIPTS_PATH}"
    if [[ "${DO_BRANCHOUT}" == "true" ]]; then
      echo "  branchout init https://github.com/kube-kaptain/kaptain.git"
      echo "  branchout pull"
    else
      echo "  git clone https://github.com/kube-kaptain/buildon-github-actions.git \\"
      echo "    ${BUILD_SCRIPTS_PATH}"
    fi
    echo ""
  fi

  if [[ "${DO_CLAUDE_PLUGINS}" == "true" ]] \
      && [[ -n "${CLAUDE_MARKETPLACES_TO_ADD}${CLAUDE_PLUGINS_TO_INSTALL}" ]]; then
    echo "Claude Code setup:"
    local m p
    for m in ${CLAUDE_MARKETPLACES_TO_ADD}; do
      echo "  claude plugin marketplace add ${m}"
    done
    for p in ${CLAUDE_PLUGINS_TO_INSTALL}; do
      echo "  claude plugin install ${p}"
    done
    echo ""
  fi

  if [[ "${DO_PROFILE_BLOCK}" == "true" ]]; then
    if [[ ${#PROFILE_LINES[@]} -gt 0 ]]; then
      echo "Shell profile (${PROFILE_FILE}):"
      echo "  Write/replace managed block with:"
      local line
      for line in "${PROFILE_LINES[@]}"; do
        echo "    ${line}"
      done
    else
      echo "Shell profile (${PROFILE_FILE}):"
      echo "  No changes - all values already present outside our managed block."
      echo "  File will NOT be touched."
    fi
    echo ""
  fi

  echo "Post-install cleanup:"
  echo "  Remove broken bash-completion file shipped by check-jsonschema (if present)"
  echo ""
}

# ---------- execution ----------

run_step() {
  echo "+ $*"
  if ! "$@"; then
    echo "ERROR: step failed: $*" >&2
    exit 1
  fi
}

# Run a shell command string (for things needing redirects/cd)
run_shell() {
  echo "+ $1"
  if ! bash -c "$1"; then
    echo "ERROR: step failed: $1" >&2
    exit 1
  fi
}

execute_plan() {
  echo ""
  echo "================================================================"
  echo "EXECUTING"
  echo "================================================================"

  if [[ "${DO_PROFILE_BLOCK}" == "true" && ${#PROFILE_LINES[@]} -gt 0 ]]; then
    echo ""
    echo "Writing managed profile block to ${PROFILE_FILE}"
    write_managed_block "${PROFILE_FILE}" "${PROFILE_LINES[@]}"
  fi

  if [[ "${APPS_TO_HOME}" == "true" ]]; then
    export HOMEBREW_CASK_OPTS="--appdir=${HOME}/Applications"
    mkdir -p "${HOME}/Applications"
  fi

  if [[ -n "${FORMULAE_TO_INSTALL}" ]]; then
    echo ""
    # shellcheck disable=SC2086
    run_step brew install ${FORMULAE_TO_INSTALL}
  fi

  if [[ -n "${CASKS_TO_INSTALL}" ]]; then
    echo ""
    # shellcheck disable=SC2086
    run_step brew install --cask ${CASKS_TO_INSTALL}
  fi

  if [[ "${RUNTIME_CHOICE}" == "podman" && "${PODMAN_NEEDS_MACHINE_SETUP}" == "true" ]]; then
    echo ""
    echo "Setting up podman machine..."
    run_step podman machine init
    run_step podman machine start
    if [[ "${PODMAN_ROOTFUL}" == "true" ]]; then
      run_step podman machine stop
      run_step podman machine set --rootful
      run_step podman machine start
    fi
  fi

  if [[ "${NEEDS_BUILD_CLONE}" == "true" ]]; then
    echo ""
    echo "Setting up kaptain build scripts at ${BUILD_SCRIPTS_PATH}..."
    if [[ "${DO_BRANCHOUT}" == "true" ]]; then
      run_shell "mkdir -p \"${HOME}/projects/kaptain\" && cd \"${HOME}/projects/kaptain\" && branchout init https://github.com/kube-kaptain/kaptain.git && branchout pull"
    else
      run_shell "mkdir -p \"$(dirname "${BUILD_SCRIPTS_PATH}")\" && git clone https://github.com/kube-kaptain/buildon-github-actions.git \"${BUILD_SCRIPTS_PATH}\""
    fi
  fi

  if [[ "${DO_CLAUDE_PLUGINS}" == "true" ]] \
      && [[ -n "${CLAUDE_MARKETPLACES_TO_ADD}${CLAUDE_PLUGINS_TO_INSTALL}" ]]; then
    echo ""
    echo "Configuring Claude Code marketplaces and plugins..."
    local m p
    for m in ${CLAUDE_MARKETPLACES_TO_ADD}; do
      run_step claude plugin marketplace add "${m}"
    done
    for p in ${CLAUDE_PLUGINS_TO_INSTALL}; do
      run_step claude plugin install "${p}"
    done
  fi

  echo ""
  echo "Post-install cleanup..."
  cleanup_broken_completions

  echo ""
  if [[ "${DO_PROFILE_BLOCK}" == "true" && ${#PROFILE_LINES[@]} -gt 0 ]]; then
    echo "Done. Open a new terminal or 'source ${PROFILE_FILE}' to pick up profile changes."
  else
    echo "Done."
  fi
}

cleanup_broken_completions() {
  # check-jsonschema ships a bash-completion file that errors in bash 3.2.
  # The file that actually gets sourced is the symlink under brew's
  # etc/bash_completion.d (and the newer share/bash-completion/completions
  # path). Removing those is enough; leaving the Cellar source alone keeps
  # brew's package state intact.
  if ! command -v brew >/dev/null 2>&1; then
    return
  fi
  local prefix
  prefix=$(brew --prefix 2>/dev/null || true)
  if [[ -z "${prefix}" ]]; then
    return
  fi
  local found_any=false
  local c
  for c in "${prefix}/etc/bash_completion.d/check-jsonschema" \
           "${prefix}/share/bash-completion/completions/check-jsonschema"; do
    if [[ -e "${c}" || -L "${c}" ]]; then
      echo "  Removing broken completion: ${c}"
      rm -f "${c}" 2>/dev/null || sudo rm -f "${c}"
      found_any=true
    fi
  done
  if [[ "${found_any}" != "true" ]]; then
    echo "  No broken completion files found."
  fi
}

# ---------- main ----------

main() {
  preflight

  echo "kaptain setup brew"
  echo "Shell:        ${SHELL_KIND} (target profile: ${PROFILE_FILE})"
  if [[ "${SHELL_KIND}" == "bash" ]]; then
    echo "Bash major:   ${BASH_MAJOR} -> ${BASH_COMPLETION_PKG}"
  fi
  if [[ "${COPY_FRED}" == "true" ]]; then
    echo "Mode:         --copy-fred (defaults accepted automatically)"
  fi

  ask_section_1_apps
  ask_section_2_profile
  ask_section_3_core
  ask_section_4_branchout
  ask_section_5_build_scripts
  ask_section_6_helm
  ask_section_7_shell_dev
  ask_section_8_gitg
  ask_section_9_kdiff3
  ask_section_10_bash_completion
  ask_section_11_runtime
  ask_section_12_gh
  ask_section_13_claude
  ask_section_14_tessl
  ask_section_15_snyk

  build_profile_lines
  print_plan

  if [[ "${COPY_FRED}" == "true" ]]; then
    echo "Proceeding (--copy-fred still requires this final confirm)."
  fi

  if ! ask_required_yn "Proceed?"; then
    echo "Aborted. No changes made."
    exit 0
  fi

  execute_plan
}

main
