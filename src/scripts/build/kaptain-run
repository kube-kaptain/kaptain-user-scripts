#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Run the main image produced by the most recent kaptain build.
# Reads the image URI and the container command from the build output
# files, publishes any exposed ports from 4242 upward, and runs it.
#
# With --bootstrap, instead runs the offline bootstrap of a released
# run-platform image, writing its own ready-to-apply manifests locally.
# Run from project root.
#
# Usage: kaptain-run [--bootstrap [--tag TAG] [--dir DIR]] [-h|--help]
set -euo pipefail

if [[ -n "${LC_ALL:-}" ]]; then
  export LANG="${LC_ALL}"
  unset LC_ALL
fi
export LC_COLLATE=C
export LC_CTYPE=C.UTF-8
UTF8_PROBE=$'\xc3\xa9'
if [[ ${#UTF8_PROBE} -ne 1 ]]; then
  echo "WARNING: C.UTF-8 locale not available, non-ASCII names will misalign" >&2
fi

OUTPUT_DIR="${KAPTAIN_USER_SCRIPTS_OUTPUT_SUB_PATH:-kaptain-out}"

# First published host port. Above the privileged and common service
# ranges, so it is unlikely to collide with anything already listening.
HOST_PORT_BASE=4242

# Release tags are plain numeric versions of one to six parts. Builds also
# push suffixed tags (-manifests and so on), which are never the image tag.
RELEASE_TAG_PATTERN='^[0-9]+(\.[0-9]+){0,5}$'

# The only project kind --bootstrap applies to
RUN_PLATFORM_KIND="kubernetes-run-platform-meta-environment"

usage() {
  echo "Usage: kaptain run [--bootstrap [--tag TAG] [--dir DIR]] [-h|--help]"
  echo ""
  echo "Run the main image from the most recent kaptain build."
  echo ""
  echo "Reads the image URI and container command from the build output in"
  echo "${OUTPUT_DIR}/reference-script-output/, then runs the image with --rm."
  echo "Each port the image exposes is published, from ${HOST_PORT_BASE} upward."
  echo ""
  echo "What the container runs is decided by the image's own CMD or ENTRYPOINT."
  echo "Runs with --init so Ctrl-C stops the container, and interactively when"
  echo "stdin and stdout are both terminals."
  echo ""
  echo "Prints a link per published TCP port, for localhost and for each address"
  echo "this machine can be reached on, so the app can be opened from Windows"
  echo "when this runs under WSL2, or from another machine on the network."
  echo ""
  echo "Run 'kaptain build' first, or 'kaptain build --run' to do both."
  echo ""
  echo "Bootstrap mode (--bootstrap) is for run-platform projects. It runs the"
  echo "bootstrap script in a released image of this project, offline, to write"
  echo "the run-platform's own ready-to-apply manifests into a local directory."
  echo "The latest release tag is used unless --tag is given. The output goes"
  echo "into bootstrap-<project>/, created private once you approve, unless --dir"
  echo "names an existing private directory. You are asked to approve, then for"
  echo "the decryption key, which goes to the container on stdin and never to"
  echo "disk. The container has no network and a read-only filesystem."
  echo ""
  echo "The output holds assembled Secrets in plain text. Delete it once used."
  echo "A script beside it, <dir>.bash, applies it as the in-cluster deploys do."
  echo ""
  echo "Options:"
  echo "  --bootstrap   Bootstrap a run-platform from a released image"
  echo "  --tag TAG     Release tag to bootstrap from (default: latest)"
  echo "  --dir DIR     Existing private directory for the output"
  echo "                (default: bootstrap-<project>, created)"
  echo "  -h, --help    Show this help"
}

BOOTSTRAP=false
BOOTSTRAP_TAG=""
BOOTSTRAP_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --bootstrap)
      BOOTSTRAP=true
      shift
      ;;
    --tag)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --tag requires a value" >&2
        usage >&2
        exit 1
      fi
      if ! [[ "$2" =~ ${RELEASE_TAG_PATTERN} ]]; then
        echo "ERROR: --tag must be a release version like 1.2.3, got: $2" >&2
        exit 1
      fi
      BOOTSTRAP_TAG="$2"
      shift 2
      ;;
    --dir)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --dir requires a value" >&2
        usage >&2
        exit 1
      fi
      if [[ "$2" == /* ]]; then
        echo "ERROR: --dir must be a relative path" >&2
        exit 1
      fi
      if [[ ! -d "$2" ]]; then
        echo "ERROR: --dir directory does not exist: $2" >&2
        exit 1
      fi
      # Trailing slash dropped: the apply script is named after the directory
      BOOTSTRAP_DIR="${2%/}"
      shift 2
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ "${BOOTSTRAP}" != "true" ]] && [[ -n "${BOOTSTRAP_TAG}" || -n "${BOOTSTRAP_DIR}" ]]; then
  echo "ERROR: --tag and --dir only apply with --bootstrap" >&2
  usage >&2
  exit 1
fi

if [[ "${BOOTSTRAP}" == "true" && ! -f "KaptainPM.yaml" ]]; then
  echo "ERROR: Not a kaptain project: no KaptainPM.yaml in ${PWD}" >&2
  exit 1
fi

STEP_OUTPUT_DIR="${OUTPUT_DIR}/reference-script-output"

# Step 1: Check there is a build to run
if [[ ! -d "${STEP_OUTPUT_DIR}" ]]; then
  echo "ERROR: No build output found: ${STEP_OUTPUT_DIR}" >&2
  echo "" >&2
  echo "Run 'kaptain build' first, or 'kaptain build --run' to do both." >&2
  exit 1
fi

# Read the last NAME=VALUE match for a key from a step output file.
# output_var appends, so a key can appear more than once; the last write
# wins. Never source these files: a value is data, not shell to execute.
read_output_var() {
  local file="$1"
  local name="$2"
  local line

  [[ -f "${file}" ]] || return 0

  line=$(grep "^${name}=" "${file}" | tail -1) || return 0
  printf '%s' "${line#*=}"
}

# Centred banner, matching the format the reference build scripts print
# before each step, so a build that runs on into a run reads as one sequence.
print_banner() {
  local title="$1"
  local inner_width=74
  local text_len=${#title}
  local pad_left=$(( (inner_width - text_len) / 2 ))
  local pad_right=$(( inner_width - text_len - pad_left ))

  echo ""
  echo "################################################################################"
  printf "###%74s###\n" ""
  printf "###%*s%s%*s###\n" "${pad_left}" "" "${title}" "${pad_right}" ""
  printf "###%74s###\n" ""
  echo "################################################################################"
  echo ""
}

# Step 2: Read the container command the build used
# Taken from the build rather than detected again, so podman versus docker
# cannot disagree between building an image and running it.
IMAGE_COMMAND=$(read_output_var "${STEP_OUTPUT_DIR}/validate-tooling" "IMAGE_BUILD_COMMAND")

if [[ -z "${IMAGE_COMMAND}" ]]; then
  echo "ERROR: Build output is incomplete: no IMAGE_BUILD_COMMAND in" >&2
  echo "       ${STEP_OUTPUT_DIR}/validate-tooling" >&2
  echo "" >&2
  echo "Run 'kaptain build' again." >&2
  exit 1
fi

# Step 3: Read the main image URI
# Bootstrap takes the kind from the project's own KaptainPM.yaml, then the
# deploy image URI the run-platform build wrote, since that kind builds no
# image from a Dockerfile. Only the repository is used: the tag comes later.
if [[ "${BOOTSTRAP}" == "true" ]]; then
  if ! command -v yq &> /dev/null; then
    echo "ERROR: yq is required for --bootstrap but not found on PATH" >&2
    exit 1
  fi

  KIND=$(yq -r '.kind // ""' "KaptainPM.yaml")
  if [[ "${KIND}" != "${RUN_PLATFORM_KIND}" ]]; then
    echo "ERROR: --bootstrap needs a ${RUN_PLATFORM_KIND} project, this is '${KIND:-unknown}'" >&2
    exit 1
  fi

  IMAGE_URI=$(read_output_var "${STEP_OUTPUT_DIR}/kubernetes-run-package" "RUN_DEPLOY_IMAGE_URI")
  if [[ -z "${IMAGE_URI}" ]]; then
    echo "ERROR: Build output is incomplete: no RUN_DEPLOY_IMAGE_URI in" >&2
    echo "       ${STEP_OUTPUT_DIR}/kubernetes-run-package" >&2
    echo "" >&2
    echo "Run 'kaptain build' again." >&2
    exit 1
  fi
else
  IMAGE_URI=$(read_output_var "${STEP_OUTPUT_DIR}/docker-build-dockerfile" "DOCKER_TARGET_IMAGE_FULL_URI")
fi

if [[ -z "${IMAGE_URI}" ]]; then
  KIND=""
  if [[ -f "KaptainPM.yaml" ]] && command -v yq &> /dev/null; then
    KIND=$(yq -r '.kind // ""' "KaptainPM.yaml")
  fi
  echo "ERROR: Project kind '${KIND:-unknown}' does not produce a runnable image." >&2
  echo "" >&2
  echo "Only project kinds that build an image from a Dockerfile can be run." >&2
  exit 1
fi

# Step 4: Read the project name, for display only
# Falls back to the directory name, since kaptain build runs from project root
PROJECT_NAME=$(read_output_var "${STEP_OUTPUT_DIR}/versions-and-naming" "PROJECT_NAME")

if [[ -z "${PROJECT_NAME}" ]]; then
  PROJECT_NAME="$(basename "${PWD}")"
fi

# Bootstrap mode: run the bootstrap script baked into a released image of
# this run-platform, offline, writing its own ready-to-apply manifests into a
# private local directory. The image is the published one for a release tag,
# not the local build: the local build only names the repository to pull from.
#
# Every check that can fail runs before the approval prompt, and the output
# directory is only created after approval. Nothing secret touches the host
# disk except the output itself: the key goes in on stdin to a tmpfs, and the
# decrypted work happens on another tmpfs.
if [[ "${BOOTSTRAP}" == "true" ]]; then
  print_banner "Kaptain CLI Run Command"

  # Step B1: Resolve the release tag
  if [[ -z "${BOOTSTRAP_TAG}" ]]; then
    # With no remote, git fetch does nothing and still succeeds
    if [[ -z "$(git remote 2> /dev/null)" ]]; then
      echo "ERROR: No git remote to fetch tags from. Pass --tag to choose a release." >&2
      exit 1
    fi

    echo "Fetching tags to find the latest release..."
    if ! git fetch --tags --quiet; then
      echo "ERROR: Could not fetch tags. Pass --tag to choose a release." >&2
      exit 1
    fi

    # Annotated only: every release tag is annotated, so a lightweight tag that
    # happens to look like a version is a local marker, not a release.
    while read -r TAG_OBJECT_TYPE TAG_REF; do
      TAG_NAME="${TAG_REF#refs/tags/}"
      if [[ "${TAG_OBJECT_TYPE}" == "tag" && "${TAG_NAME}" =~ ${RELEASE_TAG_PATTERN} ]]; then
        BOOTSTRAP_TAG="${TAG_NAME}"
        break
      fi
    done <<< "$(git for-each-ref --sort=-v:refname --format='%(objecttype) %(refname)' refs/tags)"

    if [[ -z "${BOOTSTRAP_TAG}" ]]; then
      echo "ERROR: No release tag found: none is annotated and numeric like 1.2.3" >&2
      exit 1
    fi
  fi

  # Tag stripped from the last path segment only, so a registry port survives
  BOOTSTRAP_IMAGE="${IMAGE_URI%:*}:${BOOTSTRAP_TAG}"

  # Step B2: Resolve the output directory
  # A given directory must already be private: owned by this user, with no
  # access for anyone else. The default is created that way after approval.
  CREATE_BOOTSTRAP_DIR=false
  if [[ -z "${BOOTSTRAP_DIR}" ]]; then
    BOOTSTRAP_DIR="bootstrap-${PROJECT_NAME}"
    if [[ -e "${BOOTSTRAP_DIR}" ]]; then
      echo "ERROR: ${BOOTSTRAP_DIR}/ already exists" >&2
      echo "Remove it, or pass --dir ${BOOTSTRAP_DIR} to bootstrap into it." >&2
      exit 1
    fi
    CREATE_BOOTSTRAP_DIR=true
  else
    if [[ ! -O "${BOOTSTRAP_DIR}" ]]; then
      echo "ERROR: ${BOOTSTRAP_DIR}/ is not owned by you" >&2
      exit 1
    fi
    # GNU first: BSD stat -f means filesystem there and succeeds wrongly
    DIR_MODE=$(stat -c '%a' "${BOOTSTRAP_DIR}" 2> /dev/null || stat -f '%Lp' "${BOOTSTRAP_DIR}")
    if (( 8#${DIR_MODE} & 8#077 )) || (( (8#${DIR_MODE} & 8#700) != 8#700 )); then
      echo "ERROR: ${BOOTSTRAP_DIR}/ must be private (mode 700), it is ${DIR_MODE}" >&2
      echo "Run: chmod 700 ${BOOTSTRAP_DIR}" >&2
      exit 1
    fi
  fi

  # The apply script sits beside the output directory, named after it
  BOOTSTRAP_SCRIPT="${BOOTSTRAP_DIR}.bash"
  if [[ -e "${BOOTSTRAP_SCRIPT}" ]]; then
    echo "ERROR: ${BOOTSTRAP_SCRIPT} already exists - remove it first" >&2
    exit 1
  fi

  # Step B3: Pull the release image and check it can bootstrap
  # Quiet, and stdout dropped: the engine's own progress lines only repeat
  # this. Its errors still reach stderr.
  echo "Pulling ${BOOTSTRAP_IMAGE}..."
  if ! "${IMAGE_COMMAND}" pull --quiet "${BOOTSTRAP_IMAGE}" > /dev/null; then
    echo "ERROR: Could not pull ${BOOTSTRAP_IMAGE}" >&2
    exit 1
  fi
  echo "Pulled ${BOOTSTRAP_IMAGE}"

  IMAGE_ENV=$("${IMAGE_COMMAND}" image inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "${BOOTSTRAP_IMAGE}")
  ENVIRONMENT_TYPE=$(printf '%s\n' "${IMAGE_ENV}" | sed -n 's/^ENVIRONMENT_TYPE=//p' | tail -1)
  KAPTAIN_USER_ID=$(printf '%s\n' "${IMAGE_ENV}" | sed -n 's/^KAPTAIN_USER_ID=//p' | tail -1)
  ENVIRONMENT=$(printf '%s\n' "${IMAGE_ENV}" | sed -n 's/^ENVIRONMENT=//p' | tail -1)

  if [[ "${ENVIRONMENT_TYPE}" != "meta-env" ]]; then
    echo "ERROR: ${BOOTSTRAP_IMAGE} is not a run-platform image" >&2
    echo "       (ENVIRONMENT_TYPE is '${ENVIRONMENT_TYPE}', bootstrap needs 'meta-env')" >&2
    exit 1
  fi

  # Names the namespace and field manager the apply instructions must match
  if [[ -z "${ENVIRONMENT}" ]]; then
    echo "ERROR: ${BOOTSTRAP_IMAGE} has no ENVIRONMENT" >&2
    exit 1
  fi

  if ! [[ "${KAPTAIN_USER_ID}" =~ ^[0-9]+$ ]]; then
    echo "ERROR: ${BOOTSTRAP_IMAGE} has no numeric KAPTAIN_USER_ID" >&2
    exit 1
  fi

  if ! "${IMAGE_COMMAND}" run --rm --network none --entrypoint sh "${BOOTSTRAP_IMAGE}" \
      -c 'test -x /kd/bin/bootstrap'; then
    echo "ERROR: ${BOOTSTRAP_IMAGE} has no /kd/bin/bootstrap" >&2
    echo "       It was built with deploy scripts that predate bootstrap." >&2
    exit 1
  fi

  # Step B4: Decide how the container user maps to this user
  # The image runs as KAPTAIN_USER_ID, and the output must land owned by
  # whoever ran this. macOS engines run in a VM whose file sharing already
  # writes as the host user. On Linux the mapping is explicit per engine.
  USER_ARGS=()
  MOUNT_OPTIONS=""
  if [[ "$(uname -s)" == "Linux" ]]; then
    # Relabel for SELinux hosts; ignored where SELinux is not in use
    MOUNT_OPTIONS=":Z"
    case "$(basename "${IMAGE_COMMAND}")" in
      podman)
        if [[ "$(id -u)" -eq 0 ]]; then
          USER_ARGS=(--user 0:0)
        else
          # keep-id with a target uid needs podman 4.3 or later
          PODMAN_VERSION=$("${IMAGE_COMMAND}" version --format '{{.Client.Version}}')
          PODMAN_MAJOR="${PODMAN_VERSION%%.*}"
          PODMAN_MINOR="${PODMAN_VERSION#*.}"
          PODMAN_MINOR="${PODMAN_MINOR%%.*}"
          if (( PODMAN_MAJOR < 4 || (PODMAN_MAJOR == 4 && PODMAN_MINOR < 3) )); then
            echo "ERROR: Bootstrap needs podman 4.3 or later, found ${PODMAN_VERSION}" >&2
            exit 1
          fi
          USER_ARGS=("--userns=keep-id:uid=${KAPTAIN_USER_ID},gid=${KAPTAIN_USER_ID}")
        fi
        ;;
      docker)
        # Rootless docker maps container root to this user
        if "${IMAGE_COMMAND}" info --format '{{.SecurityOptions}}' 2> /dev/null | grep -q rootless; then
          USER_ARGS=(--user 0:0)
        else
          USER_ARGS=(--user "$(id -u):$(id -g)")
        fi
        ;;
      *)
        echo "ERROR: Bootstrap on Linux supports podman and docker, not ${IMAGE_COMMAND}" >&2
        exit 1
        ;;
    esac
  fi

  # Step B5: Approval
  echo ""
  echo "Running bootstrap process against ${PROJECT_NAME} ${BOOTSTRAP_TAG} into ${BOOTSTRAP_DIR}/."
  echo "If you approve you'll be asked for the decryption key. Proceed? [Y/n]"
  while true; do
    APPROVAL=""
    if ! IFS= read -r -s -n 1 APPROVAL; then
      echo "Bootstrap cancelled."
      exit 1
    fi
    case "${APPROVAL}" in
      ""|y|Y)
        break
        ;;
      n|N|q|Q|$'\e')
        echo "Bootstrap cancelled."
        exit 1
        ;;
      *)
        echo "Press Enter or y to proceed, or n, q or Esc to stop."
        ;;
    esac
  done

  if [[ "${CREATE_BOOTSTRAP_DIR}" == "true" ]]; then
    mkdir -m 700 "${BOOTSTRAP_DIR}"
  fi

  # Removes a directory this run created, if the run left nothing in it
  remove_created_dir_if_empty() {
    if [[ "${CREATE_BOOTSTRAP_DIR}" == "true" ]]; then
      rmdir "${BOOTSTRAP_DIR}" 2> /dev/null || true
    fi
  }

  # Step B6: Decryption key, held only in this shell
  PASSPHRASE=""
  IFS= read -r -s -p "Decryption key: " PASSPHRASE || true
  echo ""
  if [[ -z "${PASSPHRASE}" ]]; then
    remove_created_dir_if_empty
    echo "ERROR: No decryption key entered" >&2
    exit 1
  fi

  # Step B7: Run it
  # Offline, read-only, no capabilities. The key goes in on stdin and lands
  # on a tmpfs where the deploy scripts look for it; the decrypted work is on
  # another tmpfs. /tmp is a tmpfs too, since tools like yq -i write a temp
  # file there and rename it into place. All vanish with the container
  # whatever the exit.
  BOOTSTRAP_DIR_ABSOLUTE="$(cd "${BOOTSTRAP_DIR}" && pwd)"
  BOOTSTRAP_ARGS=(--rm --init -i --network none --read-only
    --cap-drop ALL --security-opt no-new-privileges)
  if [[ ${#USER_ARGS[@]} -gt 0 ]]; then
    BOOTSTRAP_ARGS+=("${USER_ARGS[@]}")
  fi
  BOOTSTRAP_ARGS+=(--tmpfs "/secret:rw,mode=1777" --tmpfs "/kd/work:rw,mode=1777"
    --tmpfs "/tmp:rw,mode=1777"
    -v "${BOOTSTRAP_DIR_ABSOLUTE}:/kd/bootstrap${MOUNT_OPTIONS}"
    --entrypoint sh "${BOOTSTRAP_IMAGE}"
    -c 'cat > /secret/environmentPassphrase && exec /kd/bin/bootstrap')

  echo ""
  print_banner "Bootstrap Container Output"

  # printf is a builtin, so the key never appears in a process list
  BOOTSTRAP_STATUS=0
  printf '%s\n' "${PASSPHRASE}" | "${IMAGE_COMMAND}" run "${BOOTSTRAP_ARGS[@]}" || BOOTSTRAP_STATUS=$?
  PASSPHRASE=""

  print_banner "End Of Bootstrap Container Output"
  echo ""

  if [[ ${BOOTSTRAP_STATUS} -ne 0 ]]; then
    remove_created_dir_if_empty
    echo "ERROR: Bootstrap failed (exit ${BOOTSTRAP_STATUS})" >&2
    exit "${BOOTSTRAP_STATUS}"
  fi

  # The same namespace and field manager the in-cluster deploys apply with,
  # so those take the bootstrapped resources over rather than conflicting.
  # The namespace first, so everything namespaced in the full apply has
  # somewhere to land. A Namespace is cluster scoped, so it takes no -n.
  APPLY_FLAGS="--server-side --force-conflicts --field-manager=kaptain/meta-env/${ENVIRONMENT}"

  # A run-platform deploying itself from a suspended CronJob has nothing to
  # start it: keelson, which launches the other deploy jobs, is not deployed
  # until this one has run. So the apply script runs it once. Any secondary
  # CronJob is suffixed in both file and resource name, so only cronjob.yaml
  # named after the environment is the one.
  RUN_DEPLOY_JOB=false
  while IFS= read -r CRONJOB_FILE; do
    [[ -n "${CRONJOB_FILE}" ]] || continue
    if [[ "$(ENVIRONMENT="${ENVIRONMENT}" yq -r 'select(.kind == "CronJob" and .metadata.name == strenv(ENVIRONMENT) and .spec.suspend == true) | .metadata.name' "${CRONJOB_FILE}")" == "${ENVIRONMENT}" ]]; then
      RUN_DEPLOY_JOB=true
    fi
  done <<< "$(find "${BOOTSTRAP_DIR}" -type f -name cronjob.yaml)"

  {
    echo "#!/usr/bin/env bash"
    echo "kubectl apply ${APPLY_FLAGS} -f ${BOOTSTRAP_DIR}/namespace.yaml"
    echo "kubectl apply -n ${ENVIRONMENT} ${APPLY_FLAGS} -R -f ${BOOTSTRAP_DIR}/"
    if [[ "${RUN_DEPLOY_JOB}" == "true" ]]; then
      echo "kubectl create job -n ${ENVIRONMENT} --field-manager=kaptain/meta-env/${ENVIRONMENT} --from=cronjob/${ENVIRONMENT} ${ENVIRONMENT}-${BOOTSTRAP_TAG}-bootstrap"
    fi
  } > "${BOOTSTRAP_SCRIPT}"
  chmod 700 "${BOOTSTRAP_SCRIPT}"

  echo "Bootstrap manifests for ${PROJECT_NAME} ${BOOTSTRAP_TAG} are in ${BOOTSTRAP_DIR}/"
  echo ""
  echo "They hold secrets in plain text so delete them as soon as you've applied"
  echo "them or transferred them to the machine with cluster admin permissions."
  echo ""
  echo "Use the following script to apply them, and ensure you copy"
  echo "it with the manifests if moving them to another machine:"
  echo ""
  echo "  ./${BOOTSTRAP_SCRIPT}"
  echo ""
  exit 0
fi

# Step 5: Resolve the reference to run
# Prefer the base URI, which is what actually ships: under podman a
# multi-platform build leaves it as a local manifest list, and run resolves
# that to the host architecture. Only docker needs the fallback, because it
# cannot create a local manifest list, so a multi-platform build leaves
# nothing but the per-architecture tags. Testing the base URI locally first
# is what stops docker reaching for the registry and running a stale remote
# image carrying the same tag.
case "$(uname -m)" in
  x86_64|amd64)
    HOST_ARCH="amd64"
    ;;
  arm64|aarch64)
    HOST_ARCH="arm64"
    ;;
  *)
    HOST_ARCH=""
    ;;
esac

# image inspect works on both engines; image exists is podman only.
image_exists() {
  "${IMAGE_COMMAND}" image inspect "$1" > /dev/null 2>&1
}

if image_exists "${IMAGE_URI}"; then
  IMAGE_REF="${IMAGE_URI}"
elif [[ -n "${HOST_ARCH}" ]] && image_exists "${IMAGE_URI}-linux-${HOST_ARCH}"; then
  IMAGE_REF="${IMAGE_URI}-linux-${HOST_ARCH}"
else
  echo "ERROR: No local image found for: ${IMAGE_URI}" >&2
  echo "" >&2
  echo "Tags present locally for this repository:" >&2
  "${IMAGE_COMMAND}" image list --format '{{.Repository}}:{{.Tag}}' 2> /dev/null \
    | grep -F "${IMAGE_URI%%:*}" >&2 || echo "  (none)" >&2
  exit 1
fi

# Step 6: Map every exposed port, from HOST_PORT_BASE upward
EXPOSED_PORTS=$("${IMAGE_COMMAND}" image inspect --format '{{json .Config.ExposedPorts}}' "${IMAGE_REF}" 2> /dev/null || true)

PORT_ARGS=()

# 'host container' pairs worth linking to. TCP only: a browser cannot open
# a UDP port, though it is still published.
LINK_PORTS=()

if [[ -n "${EXPOSED_PORTS}" && "${EXPOSED_PORTS}" != "null" ]]; then
  # {"8080/tcp":{},"80/tcp":{}} becomes one 'port/proto' per line, lowest first
  PORT_SPECS=$(printf '%s' "${EXPOSED_PORTS}" \
    | tr ',' '\n' \
    | sed -n 's|.*"\([0-9][0-9]*/[a-z][a-z]*\)".*|\1|p' \
    | sort -t/ -k1,1n)

  HOST_PORT="${HOST_PORT_BASE}"

  # Here-string, not a pipe: a pipe would run the loop in a subshell and
  # lose PORT_ARGS and HOST_PORT on the way out.
  while IFS= read -r PORT_SPEC; do
    [[ -n "${PORT_SPEC}" ]] || continue

    CONTAINER_PORT="${PORT_SPEC%%/*}"
    PROTOCOL="${PORT_SPEC##*/}"

    if [[ "${PROTOCOL}" == "tcp" ]]; then
      PORT_ARGS+=(-p "${HOST_PORT}:${CONTAINER_PORT}")
      LINK_PORTS+=("${HOST_PORT} ${CONTAINER_PORT}")
    else
      PORT_ARGS+=(-p "${HOST_PORT}:${CONTAINER_PORT}/${PROTOCOL}")
    fi

    HOST_PORT=$((HOST_PORT + 1))
  done <<< "${PORT_SPECS}"
fi

# Step 7: Find the addresses this machine can be reached on
#
# Best effort throughout. A missing command or an unparsable format means
# fewer links, never a failure: the container still runs.
#
# Emits 'interface address' pairs. iproute2 first, since Linux and WSL2 may
# have no ifconfig at all; 'scope global' already excludes loopback and
# link-local there. ifconfig covers macOS, which has no ip.
list_interface_addresses() {
  if command -v ip &> /dev/null; then
    ip -4 -o addr show scope global 2> /dev/null \
      | awk '{ address = $4; sub(/\/.*/, "", address); print $2, address }'
    return 0
  fi

  if command -v ifconfig &> /dev/null; then
    ifconfig 2> /dev/null \
      | awk '/^[a-zA-Z0-9_]+:/ { interface = $1; sub(/:$/, "", interface) }
             /^[ \t]*inet / { print interface, $2 }'
    return 0
  fi
}

HOST_ADDRESSES=()

while read -r INTERFACE ADDRESS; do
  [[ -n "${ADDRESS:-}" ]] || continue

  # Loopback is already listed separately, link-local reaches nothing
  case "${ADDRESS}" in
    127.*|169.254.*)
      continue
      ;;
  esac

  # Container and VM bridges carry real addresses on Linux, reachable from
  # this host but from nowhere else. Filtering by name, never by range: on
  # WSL2 the address worth having is a 172.x one on eth0.
  case "${INTERFACE}" in
    docker0|podman*|cni-podman*|br-*|virbr*|veth*)
      continue
      ;;
  esac

  HOST_ADDRESSES+=("${ADDRESS}")
done <<< "$(list_interface_addresses || true)"

# Step 8: Run it
#
# --init puts catatonit (podman) or docker-init (docker) at PID 1, which
# installs signal handlers and forwards them on. Without it the image's own
# command is PID 1, and the kernel applies no default signal actions to PID 1,
# so a process with no SIGINT handler discards Ctrl-C entirely and the
# container can only be stopped from another terminal.
RUN_ARGS=(--rm --init)

# Interactive only when both ends are a terminal. Keeps 'kaptain run > file'
# and CI output free of TTY escapes, and avoids allocating a TTY with no
# stdin attached.
if [[ -t 0 && -t 1 ]]; then
  RUN_ARGS+=(-it)
fi

if [[ ${#PORT_ARGS[@]} -gt 0 ]]; then
  RUN_ARGS+=("${PORT_ARGS[@]}")
fi

print_banner "Kaptain CLI Run Command"

echo "Running latest main image for ${PROJECT_NAME}:"
echo ""
echo "${IMAGE_COMMAND} run ${RUN_ARGS[*]} ${IMAGE_REF}"

if [[ ${#LINK_PORTS[@]} -gt 0 ]]; then
  echo ""
  echo "To view your app or site, use the below URLs:"
  echo ""
  echo "Local:"
  for LINK_PORT in "${LINK_PORTS[@]}"; do
    echo "  http://localhost:${LINK_PORT%% *}  (container ${LINK_PORT##* })"
  done

  if [[ ${#HOST_ADDRESSES[@]} -gt 0 ]]; then
    echo ""
    echo "Network (from Windows with this in WSL2, or another machine):"
    for HOST_ADDRESS in "${HOST_ADDRESSES[@]}"; do
      for LINK_PORT in "${LINK_PORTS[@]}"; do
        echo "  http://${HOST_ADDRESS}:${LINK_PORT%% *}  (container ${LINK_PORT##* })"
      done
    done
  else
    echo ""
    echo "No network addresses found, so only localhost is listed."
  fi
fi

echo ""
echo "Press Ctrl-C to stop."
echo ""

exec "${IMAGE_COMMAND}" run "${RUN_ARGS[@]}" "${IMAGE_REF}"
