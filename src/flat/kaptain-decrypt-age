#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Decrypt all .age files in src/secrets/ to .txt files.
# Run from repo root. Symmetric with encrypt-secrets.
#
# Usage: decrypt-secrets
set -euo pipefail

# Handle arguments
SECRETS_DIR="${KAPTAIN_USER_SCRIPTS_SECRETS_DIR:-src/secrets}"
KEY_FILE=""
SHOW=false
TOKEN=""

USAGE="Usage: $(basename "$0") [--dir DIR] [--key-file FILE] [--show [--token NAME]]"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir)
      if [[ -z "${2:-}" ]]; then
        echo "ERROR: --dir requires an argument" >&2
        exit 1
      fi
      if [[ "$2" == /* ]]; then
        echo "ERROR: --dir must be a relative path, i.e. a sub path of this repo" >&2
        exit 1
      fi
      if [[ ! -d "$2" ]]; then
        echo "ERROR: Directory not found: $2" >&2
        exit 1
      fi
      SECRETS_DIR="$2"
      shift 2
      ;;
    --key-file)
      if [[ -z "${2:-}" ]]; then
        echo "ERROR: --key-file requires an argument" >&2
        exit 1
      fi
      if [[ ! -f "$2" ]]; then
        echo "ERROR: Key file not found: $2" >&2
        exit 1
      fi
      KEY_FILE="$2"
      shift 2
      ;;
    --show)
      SHOW=true
      shift
      ;;
    --token)
      if [[ -z "${2:-}" ]]; then
        echo "ERROR: --token requires an argument" >&2
        exit 1
      fi
      TOKEN="$2"
      shift 2
      ;;
    -h|--help)
      echo "${USAGE}"
      echo ""
      echo "  --show          Emit NAME\\0VALUE\\0 pairs on stdout instead of"
      echo "                  writing .txt files. Nothing is written to disk."
      echo "  --token NAME    With --show, decrypt only this one token"
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      echo "${USAGE}" >&2
      exit 1
      ;;
  esac
done

if [[ ! -d "${SECRETS_DIR}" ]]; then
  echo "ERROR: ${SECRETS_DIR} directory not found - run from repo root" >&2
  exit 1
fi

if ! command -v age &> /dev/null; then
  echo "ERROR: age is required but not installed" >&2
  exit 1
fi

# Find .age files
age_files=()
while IFS= read -r -d '' file; do
  age_files+=("$file")
done < <(find "${SECRETS_DIR}" -name "*.age" -type f -print0)

if [[ ${#age_files[@]} -eq 0 ]]; then
  if [[ "${SHOW}" == "true" ]]; then
    echo "No .age files found in ${SECRETS_DIR}" >&2
  else
    echo "No .age files found in ${SECRETS_DIR}"
  fi
  exit 0
fi

if [[ "${SHOW}" == "false" ]]; then
  echo "Found ${#age_files[@]} .age file(s) to decrypt"
fi

# Get identity (secret key) from key file or prompt
if [[ -n "${KEY_FILE}" ]]; then
  identity=$(<"${KEY_FILE}")
else
  read -r -s -p "Enter passphrase: " identity
  # Belongs with the prompt on stderr, or it corrupts the --show stream
  echo >&2
fi

# Validate identity is a valid age secret key
if [[ "${identity}" != AGE-SECRET-KEY-* ]]; then
  echo "ERROR: Not a valid age secret key" >&2
  exit 1
fi

# Show mode: emit NAME\0VALUE\0 pairs on stdout and write nothing to disk.
# NUL delimiting needs no escaping, so values survive newlines, quotes and
# trailing whitespace byte for byte. Progress and errors go to stderr so they
# cannot land in the middle of the stream.
if [[ "${SHOW}" == "true" ]]; then
  show_failed=0
  for age_file in "${age_files[@]}"; do
    name="${age_file#"${SECRETS_DIR}/"}"
    name="${name%.age}"
    if [[ -n "${TOKEN}" && "${name}" != "${TOKEN}" ]]; then
      continue
    fi

    # Sentinel X keeps trailing newlines that command substitution would strip,
    # and the inner exit carries the real status out of the subshell
    rc=0
    value=$(age -d -i <(printf '%s\n' "${identity}") "${age_file}" 2>/dev/null; s=$?; printf X; exit "${s}") || rc=$?
    if [[ ${rc} -ne 0 ]]; then
      echo "ERROR: Failed to decrypt ${age_file}" >&2
      show_failed=$((show_failed + 1))
      continue
    fi

    printf '%s\0%s\0' "${name}" "${value%X}"
  done

  if [[ ${show_failed} -gt 0 ]]; then
    exit 1
  fi
  exit 0
fi

# Decrypt each file
# age -i wants a path, so the identity is handed over on a pipe via /dev/fd
# rather than written to disk. It must be created per invocation: a pipe is
# drained by the first reader, so one shared fd would only serve one file.
success_count=0
fail_count=0
failed_files=()

echo ""
for age_file in "${age_files[@]}"; do
  txt_file="${age_file%.age}.txt"
  dir=$(dirname "${age_file}")
  echo -n "Decrypting ${dir}/{$(basename "${age_file}") => $(basename "${txt_file}")}"
  if age -d -i <(printf '%s\n' "${identity}") -o "${txt_file}" "${age_file}" 2>/dev/null; then
    echo ""
    success_count=$((success_count + 1))
  else
    echo " FAILED"
    fail_count=$((fail_count + 1))
    failed_files+=("${age_file}")
  fi
done
echo ""

echo "Done. ${success_count} succeeded, ${fail_count} failed."

if [[ ${fail_count} -gt 0 ]]; then
  echo ""
  echo "Failed files:"
  for f in "${failed_files[@]}"; do
    echo "  ${f}"
  done
  exit 1
fi
