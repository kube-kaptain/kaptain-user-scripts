# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Normalise single-line secret token values by stripping the trailing newline.
# The secrets counterpart of `kaptain normalise config`, using the same rule:
# a value with exactly one '\n', at the end, is rewritten without it. Values
# with zero newlines are already canonical; multi-line values are intentional.
#
# Unlike config this is a decrypt/re-encrypt round trip with the same key, so
# it rewrites ciphertext. Only the tokens that actually change are re-encrypted.
#
# Usage: kaptain normalise secrets [--dir DIR] [--dry-run]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_DIR="${KAPTAIN_USER_SCRIPTS_SECRETS_DIR:-src/secrets}"
DRY_RUN=false

NORMALISED_COUNT=0
NO_NEWLINE_COUNT=0
MULTI_NEWLINE_COUNT=0

# "token" / "tokens" for proper pluralisation
token_word() {
  if [[ "$1" -eq 1 ]]; then echo "token"; else echo "tokens"; fi
}

usage() {
  echo "Usage: kaptain normalise secrets [--dir DIR] [--dry-run]"
  echo ""
  echo "Strip the trailing newline from single-line secret token values."
  echo "Targets values with exactly one '\\n', at the end (the same set flagged"
  echo "as 'One newline (run kaptain normalise secrets to strip)' by"
  echo "'kaptain list secrets --decrypt')."
  echo "Zero-newline values are already canonical; multi-line values are"
  echo "treated as intentional."
  echo ""
  echo "This decrypts and re-encrypts with the same key, so the encrypted files"
  echo "must be committed first. Only tokens that change are re-encrypted."
  echo ""
  echo "Options:"
  echo "  --dir DIR     Secrets directory (default: src/secrets)"
  echo "  --dry-run     Show what would change without re-encrypting"
  echo "  -h, --help    Show this help"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --dir)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --dir requires a value" >&2
        exit 1
      fi
      if [[ "$2" == /* ]]; then
        echo "ERROR: --dir must be a relative path, i.e. a sub path of this repo" >&2
        exit 1
      fi
      if [[ ! -d "$2" ]]; then
        echo "ERROR: Directory not found: $2" >&2
        exit 1
      fi
      SECRETS_DIR="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -d "${SECRETS_DIR}" ]]; then
  echo "ERROR: Secrets directory not found: ${SECRETS_DIR}" >&2
  exit 1
fi

# --- Pre-flight: directory must be clean ---
# Decryption writes .txt here, so anything already present would be clobbered
# or swept up in the re-encryption.

txt_files=()
while IFS= read -r -d '' file; do
  txt_files+=("$file")
done < <(find "${SECRETS_DIR}" -name "*.txt" -type f -print0 2>/dev/null)

raw_files=()
while IFS= read -r -d '' file; do
  raw_files+=("$file")
done < <(find "${SECRETS_DIR}" -name "*.raw" -type f -print0 2>/dev/null)

if [[ ${#txt_files[@]} -gt 0 || ${#raw_files[@]} -gt 0 ]]; then
  echo "ERROR: Secrets directory is not clean" >&2
  echo "Found ${#txt_files[@]} .txt and ${#raw_files[@]} .raw file(s)" >&2
  echo "Run 'kaptain clean secrets' first" >&2
  exit 1
fi

# --- Determine type and collect the encrypted files ---

TYPE=$("${SCRIPT_DIR}/kaptain-encryption-detect-type" --dir "${SECRETS_DIR}")

enc_files=()
while IFS= read -r -d '' file; do
  enc_files+=("$file")
done < <(find "${SECRETS_DIR}" -name "*.${TYPE}" -type f -print0 2>/dev/null | sort -z)

# --- Check encrypted files are accounted for in git ---
# Re-encryption rewrites them in place. Git history is the way back if anything
# goes wrong, so refuse to start unless they are committed and unmodified.
# A dry run writes no ciphertext, so it does not need the guarantee.

if [[ "${DRY_RUN}" == "false" ]]; then
  if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "ERROR: Not inside a git repository" >&2
    echo "Normalising rewrites the encrypted files" >&2
    echo "Without git history there is no way back if something goes wrong" >&2
    exit 1
  fi

  if ! git rev-parse --verify HEAD > /dev/null 2>&1; then
    echo "ERROR: Repository has no commits" >&2
    echo "Commit the encrypted files before normalising - they are the only copy" >&2
    exit 1
  fi

  untracked_enc=()
  modified_enc=()
  for enc_file in "${enc_files[@]}"; do
    if ! git ls-files --error-unmatch -- "${enc_file}" > /dev/null 2>&1; then
      untracked_enc+=("${enc_file}")
    elif ! git diff --quiet HEAD -- "${enc_file}" > /dev/null 2>&1; then
      modified_enc+=("${enc_file}")
    fi
  done

  if [[ ${#untracked_enc[@]} -gt 0 || ${#modified_enc[@]} -gt 0 ]]; then
    echo "ERROR: Encrypted files are not accounted for in git" >&2
    echo "Found ${#untracked_enc[@]} untracked and ${#modified_enc[@]} uncommitted file(s)" >&2
    if [[ ${#untracked_enc[@]} -gt 0 ]]; then
      echo "  Untracked:" >&2
      for f in "${untracked_enc[@]}"; do
        echo "    ${f}" >&2
      done
    fi
    if [[ ${#modified_enc[@]} -gt 0 ]]; then
      echo "  Uncommitted changes:" >&2
      for f in "${modified_enc[@]}"; do
        echo "    ${f}" >&2
      done
    fi
    echo "Commit them first - normalising rewrites them and git history is the way back" >&2
    exit 1
  fi
fi

echo "Normalising ${#enc_files[@]} ${TYPE} $(token_word ${#enc_files[@]}) in ${SECRETS_DIR}"

# --- Decrypt with the current key ---
# The passphrase is piped to each leaf's prompt, so it is never written to disk
# and never becomes an argument of any process.

read -r -s -p "Enter key: " passphrase
echo

echo ""
echo "Decrypting..."
if ! printf '%s\n' "${passphrase}" | "${SCRIPT_DIR}/kaptain-decrypt-${TYPE}" --dir "${SECRETS_DIR}"; then
  echo "" >&2
  echo "Cleaning up decrypted files..." >&2
  find "${SECRETS_DIR}" -name "*.txt" -type f -delete 2>/dev/null || true
  echo "Normalise aborted. No files were changed." >&2
  exit 1
fi

# --- Classify and stage the ones that need changing ---
# Same rule as kaptain-normalise-config: exactly one newline, at the end.

echo ""
staged=()
while IFS= read -r -d '' txt_file; do
  display="${txt_file#"${SECRETS_DIR}/"}"
  display="${display%.txt}"

  newline_count=$(tr -cd '\n' < "${txt_file}" | wc -c | tr -d '[:space:]')

  if [[ "${newline_count}" -eq 0 ]]; then
    NO_NEWLINE_COUNT=$((NO_NEWLINE_COUNT + 1))
    rm -f "${txt_file}"
    continue
  fi

  # Sentinel pattern: $() strips trailing newlines, so append a marker first.
  tail_byte="$(tail -c 1 "${txt_file}"; printf X)"
  tail_byte="${tail_byte%X}"

  # Multi-newline OR one newline mid-file - multi-line, leave alone.
  if [[ "${newline_count}" -gt 1 || "${tail_byte}" != $'\n' ]]; then
    MULTI_NEWLINE_COUNT=$((MULTI_NEWLINE_COUNT + 1))
    rm -f "${txt_file}"
    continue
  fi

  # Exactly one trailing newline. Command substitution strips all trailing
  # newlines, giving the canonical form for free.
  stripped="$(cat "${txt_file}")"

  if [[ "${DRY_RUN}" == "true" ]]; then
    echo "  would normalise: ${display}"
    rm -f "${txt_file}"
  else
    raw_file="${txt_file%.txt}.raw"
    printf '%s' "${stripped}" > "${raw_file}"
    rm -f "${txt_file}"
    staged+=("${raw_file}")
    echo "  normalising: ${display}"
  fi
  NORMALISED_COUNT=$((NORMALISED_COUNT + 1))
done < <(find "${SECRETS_DIR}" -name "*.txt" -type f -print0 2>/dev/null | sort -z)

summary="${NORMALISED_COUNT} normalised, ${NO_NEWLINE_COUNT} already canonical, ${MULTI_NEWLINE_COUNT} multi-line"

if [[ "${DRY_RUN}" == "true" ]]; then
  echo ""
  echo "Dry run. Nothing was re-encrypted."
  echo "Summary: ${summary}"
  exit 0
fi

if [[ ${NORMALISED_COUNT} -eq 0 ]]; then
  echo "  nothing to normalise"
  echo ""
  echo "Summary: ${summary}"
  exit 0
fi

# --- Re-encrypt the changed tokens with the same key ---
# The encrypt leaf validates the key against the untouched ciphertext before
# writing anything, so a wrong key cannot silently rewrite these.

echo ""
echo "Re-encrypting with the same key..."
if ! printf '%s\n' "${passphrase}" | "${SCRIPT_DIR}/kaptain-encrypt-${TYPE}" --dir "${SECRETS_DIR}"; then
  echo "" >&2
  echo "ERROR: Re-encryption failed" >&2
  echo "The affected values are still available as .raw files in ${SECRETS_DIR}:" >&2
  for f in "${staged[@]}"; do
    echo "    ${f}" >&2
  done
  echo "Re-encrypt them manually, or restore the encrypted files from git" >&2
  exit 1
fi

find "${SECRETS_DIR}" -name "*.raw" -type f -delete 2>/dev/null || true

echo ""
echo "Summary: ${summary}"
