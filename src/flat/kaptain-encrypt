#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Kaptain encrypt router - auto-detects/defaults encryption type and delegates
#
# Type selection logic:
# 1. Directory with only .raw files: default to age
# 2. Directory with some encrypted files: use that type
# 3. Mixed encrypted types: error
# 4. Explicit --type override always wins
#
# Usage: kaptain-encrypt [--type TYPE] [--dir DIR]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_TYPE="${KAPTAIN_USER_SCRIPTS_ENCRYPTION_TYPE:-age}"

# Parse arguments - consume --type, pass everything else through
TYPE=""
DIR="${KAPTAIN_USER_SCRIPTS_SECRETS_DIR:-src/secrets}"
PASSTHROUGH=()

usage() {
  echo "Usage: kaptain encrypt [--type TYPE] [--dir DIR]"
  echo ""
  echo "Options:"
  echo "  --type TYPE   Encryption type (default: age, or matches existing)"
  echo "  --dir DIR     Target directory (default: src/secrets)"
  echo ""
  echo "Supported types: age, sha256.aes256, sha256.aes256.10k, sha256.aes256.100k, sha256.aes256.600k"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --type requires a value" >&2
        usage >&2
        exit 1
      fi
      TYPE="$2"
      shift 2
      ;;
    --dir)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --dir requires a value" >&2
        usage >&2
        exit 1
      fi
      DIR="$2"
      PASSTHROUGH+=("$1" "$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# Reject absolute paths
if [[ "${DIR}" == /* ]]; then
  echo "ERROR: --dir must be a relative path, i.e. a sub path of this repo" >&2
  exit 1
fi

if [[ ! -d "${DIR}" ]]; then
  echo "ERROR: Directory not found: ${DIR}" >&2
  exit 1
fi

# Check gitignore configuration before proceeding
"${SCRIPT_DIR}/kaptain-encryption-check-ignores" --dir "${DIR}"

# Supported types and directory detection both come from the shared helper
DETECT_TYPE="${SCRIPT_DIR}/kaptain-encryption-detect-type"

SUPPORTED_TYPES=()
while IFS= read -r suffix; do
  SUPPORTED_TYPES+=("${suffix}")
done < <("${DETECT_TYPE}" --list)

if [[ ${#SUPPORTED_TYPES[@]} -eq 0 ]]; then
  echo "ERROR: No encryption scripts found in ${SCRIPT_DIR}" >&2
  exit 1
fi

# Check if type is supported
is_supported_type() {
  local check_type="$1"
  local t
  for t in ${SUPPORTED_TYPES[@]+"${SUPPORTED_TYPES[@]}"}; do
    if [[ "${t}" == "${check_type}" ]]; then
      return 0
    fi
  done
  return 1
}

# Determine type
if [[ -z "${TYPE}" ]]; then
  # --allow-none because encrypting a not-yet-encrypted directory is normal;
  # mixed types still fail here and stop the run
  existing_type=$("${DETECT_TYPE}" --dir "${DIR}" --allow-none)

  if [[ -n "${existing_type}" ]]; then
    TYPE="${existing_type}"
    echo "Using existing encryption type: ${TYPE}"
  else
    TYPE="${DEFAULT_TYPE}"
    echo "No existing encrypted files, defaulting to: ${TYPE}"
  fi
fi

# Validate type
if ! is_supported_type "${TYPE}"; then
  echo "ERROR: Unsupported encryption type: ${TYPE}" >&2
  echo "Supported types: ${SUPPORTED_TYPES[*]}" >&2
  exit 1
fi

# Delegate to specific script
ENCRYPT_SCRIPT="${SCRIPT_DIR}/kaptain-encrypt-${TYPE}"

if [[ ! -x "${ENCRYPT_SCRIPT}" ]]; then
  echo "ERROR: Encrypt script not found: ${ENCRYPT_SCRIPT}" >&2
  exit 1
fi

exec "${ENCRYPT_SCRIPT}" ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
