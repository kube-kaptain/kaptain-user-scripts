#
# List config and defaults files and their values.
# Run from repo root.
#
# Usage: kaptain-list-config [--dir DIR] [--defaults-dir DIR] [--all]
set -euo pipefail

CONFIG_DIR="${KAPTAIN_USER_SCRIPTS_CONFIG_DIR:-src/config}"
DEFAULTS_DIR="${KAPTAIN_USER_SCRIPTS_DEFAULTS_DIR:-src/defaults}"
CONFIG_DIR_EXPLICIT=false
DEFAULTS_DIR_EXPLICIT=false
ALL_PROJECTS=false

usage() {
  echo "Usage: kaptain list config [--dir DIR] [--defaults-dir DIR] [--all]"
  echo ""
  echo "List config and defaults files and their values."
  echo ""
  echo "Options:"
  echo "  --dir DIR           Config directory (default: src/config)"
  echo "  --defaults-dir DIR  Defaults directory (default: src/defaults)"
  echo "  --all               List all projects in branchout tree"
  echo "  -h, --help          Show this help"
}

# Find branchout root by walking up from cwd
# Sets BRANCHOUT_ROOT on success, exits on failure
find_branchout_root() {
  local dir="${PWD}"
  BRANCHOUT_PROJECTS_DIRECTORY="${BRANCHOUT_PROJECTS_DIRECTORY:-projects}"
  # shellcheck disable=SC1091
  test -f ~/.config/branchoutrc && source ~/.config/branchoutrc
  local home_projects="${HOME}/${BRANCHOUT_PROJECTS_DIRECTORY}"

  if [[ "${dir}" != "${home_projects}/"* ]]; then
    echo "ERROR: Not under ${home_projects}/, cannot find branchout tree" >&2
    exit 1
  fi

  while [[ "${dir}" != "${home_projects}" && "${dir}" != "/" ]]; do
    if [[ -f "${dir}/Branchoutfile" && -f "${dir}/Branchoutprojects" ]]; then
      BRANCHOUT_ROOT="${dir}"
      return 0
    fi
    dir=$(dirname "${dir}")
  done

  echo "ERROR: Branchout root not found" >&2
  echo "ERROR: Cannot perform --all listing without a valid structure" >&2
  exit 1
}

# Print categorised file listing for a single directory.
#   $1 = directory path
#   $2 = indent prefix ("" for single-section, "  " for sub-section)
# Sets LAST_NO_NEWLINE_COUNT, LAST_ONE_NEWLINE_COUNT, LAST_MULTILINE_COUNT
# and LAST_HAS_ANY_FILES (true/false) for callers building combined summaries.
print_categorised() {
  local config_dir="$1"
  local indent="$2"

  LAST_NO_NEWLINE_COUNT=0
  LAST_ONE_NEWLINE_COUNT=0
  LAST_MULTILINE_COUNT=0
  LAST_HAS_ANY_FILES=false

  local files=()
  local rels=()
  while IFS= read -r -d '' file; do
    files+=("${file}")
    rels+=("${file#"${config_dir}/"}")
  done < <(find "${config_dir}" -type f -print0 | sort -z)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo ""
    echo "${indent}No files found"
    return 0
  fi

  LAST_HAS_ANY_FILES=true

  local no_newline_rels=()
  local no_newline_vals=()
  local one_newline_rels=()
  local one_newline_vals=()
  local multiline_rels=()
  local multiline_counts=()

  local i
  for i in "${!files[@]}"; do
    local rel="${rels[$i]}"
    local newline_count
    newline_count=$(tr -cd '\n' < "${files[$i]}" | wc -c | tr -d ' ')

    if [[ ${newline_count} -eq 0 ]]; then
      no_newline_rels+=("${rel}")
      no_newline_vals+=("$(cat "${files[$i]}")")
    elif [[ ${newline_count} -eq 1 ]]; then
      one_newline_rels+=("${rel}")
      one_newline_vals+=("$(cat "${files[$i]}")")
    else
      multiline_rels+=("${rel}")
      multiline_counts+=("${newline_count}")
    fi
  done

  LAST_NO_NEWLINE_COUNT=${#no_newline_rels[@]}
  LAST_ONE_NEWLINE_COUNT=${#one_newline_rels[@]}
  LAST_MULTILINE_COUNT=${#multiline_rels[@]}

  local max_len=0
  local rel
  for rel in "${no_newline_rels[@]+"${no_newline_rels[@]}"}" "${one_newline_rels[@]+"${one_newline_rels[@]}"}" "${multiline_rels[@]+"${multiline_rels[@]}"}"; do
    if [[ ${#rel} -gt ${max_len} ]]; then
      max_len=${#rel}
    fi
  done
  local pad=$((max_len + 3))

  if [[ ${#no_newline_rels[@]} -gt 0 ]]; then
    echo ""
    echo "${indent}No newline (usually correct):"
    for i in "${!no_newline_rels[@]}"; do
      printf "${indent}  %-${pad}s%s\n" "${no_newline_rels[$i]}:" "${no_newline_vals[$i]}"
    done
  fi

  if [[ ${#one_newline_rels[@]} -gt 0 ]]; then
    echo ""
    echo "${indent}One newline (consider stripping):"
    for i in "${!one_newline_rels[@]}"; do
      printf "${indent}  %-${pad}s%s\n" "${one_newline_rels[$i]}:" "${one_newline_vals[$i]}"
    done
  fi

  if [[ ${#multiline_rels[@]} -gt 0 ]]; then
    echo ""
    echo "${indent}Multiline (cat <file> to inspect):"
    for i in "${!multiline_rels[@]}"; do
      printf "${indent}  %-${pad}s%s lines\n" "${multiline_rels[$i]}:" "${multiline_counts[$i]}"
    done
  fi
}

# Build a "N no-newline, N one-newline, N multiline" string from counts.
build_summary() {
  local no_n="$1"
  local one_n="$2"
  local multi_n="$3"
  local parts=()
  [[ ${no_n} -gt 0 ]] && parts+=("${no_n} no-newline")
  [[ ${one_n} -gt 0 ]] && parts+=("${one_n} one-newline")
  [[ ${multi_n} -gt 0 ]] && parts+=("${multi_n} multiline")

  local out=""
  local part
  for part in "${parts[@]+"${parts[@]}"}"; do
    if [[ -n "${out}" ]]; then
      out+=", "
    fi
    out+="${part}"
  done
  echo "${out}"
}

# Print listing for one project root (or current dir if empty).
# Detects which of config/defaults exist and dispatches.
#   $1 = filesystem prefix ("" for cwd, "<abs path>/" for branchout iteration)
#   $2 = display name to append after "in" ("" for none, e.g. "group/group-alpha")
# Returns 1 if neither exists.
list_project() {
  local prefix="$1"
  local display_in="${2:-}"
  local config_path="${prefix}${CONFIG_DIR}"
  local defaults_path="${prefix}${DEFAULTS_DIR}"

  local has_config=false
  local has_defaults=false
  [[ -d "${config_path}" ]] && has_config=true
  [[ -d "${defaults_path}" ]] && has_defaults=true

  if [[ "${has_config}" == "false" && "${has_defaults}" == "false" ]]; then
    return 1
  fi

  local in_suffix=""
  [[ -n "${display_in}" ]] && in_suffix=" in ${display_in}"

  if [[ "${has_config}" == "true" && "${has_defaults}" == "true" ]]; then
    echo "Listing ${CONFIG_DIR} and ${DEFAULTS_DIR}${in_suffix}:"

    echo ""
    echo "[${CONFIG_DIR}]"
    print_categorised "${config_path}" "  "
    local c_no=${LAST_NO_NEWLINE_COUNT} c_one=${LAST_ONE_NEWLINE_COUNT} c_multi=${LAST_MULTILINE_COUNT}
    local c_total=$((c_no + c_one + c_multi))

    echo ""
    echo "[${DEFAULTS_DIR}]"
    print_categorised "${defaults_path}" "  "
    local d_no=${LAST_NO_NEWLINE_COUNT} d_one=${LAST_ONE_NEWLINE_COUNT} d_multi=${LAST_MULTILINE_COUNT}
    local d_total=$((d_no + d_one + d_multi))

    local config_summary defaults_summary
    config_summary=$(build_summary "${c_no}" "${c_one}" "${c_multi}")
    defaults_summary=$(build_summary "${d_no}" "${d_one}" "${d_multi}")
    [[ -z "${config_summary}" ]] && config_summary="empty"
    [[ -z "${defaults_summary}" ]] && defaults_summary="empty"

    local label_width=${#CONFIG_DIR}
    [[ ${#DEFAULTS_DIR} -gt ${label_width} ]] && label_width=${#DEFAULTS_DIR}
    local pad=$((label_width + 2))

    echo ""
    echo "Summary:"
    printf "  %-${pad}s %s\n" "${CONFIG_DIR}:" "${config_summary}"
    printf "  %-${pad}s %s\n" "${DEFAULTS_DIR}:" "${defaults_summary}"
    echo "  Total: $((c_total + d_total)) values"
    return 0
  fi

  # Single-section mode
  local path dir_name
  if [[ "${has_config}" == "true" ]]; then
    path="${config_path}"
    dir_name="${CONFIG_DIR}"
  else
    path="${defaults_path}"
    dir_name="${DEFAULTS_DIR}"
  fi
  echo "Listing ${dir_name}${in_suffix}:"
  print_categorised "${path}" ""

  if [[ "${LAST_HAS_ANY_FILES}" == "true" ]]; then
    local summary
    summary=$(build_summary "${LAST_NO_NEWLINE_COUNT}" "${LAST_ONE_NEWLINE_COUNT}" "${LAST_MULTILINE_COUNT}")
    echo ""
    echo "Summary: ${summary}"
  fi
}

# List all projects in branchout tree
list_all_projects() {
  find_branchout_root
  echo "Found branchout root: ${BRANCHOUT_ROOT}"

  # Compute search depth from CONFIG_DIR/DEFAULTS_DIR segment count + 2 (group/project)
  local config_segments defaults_segments
  config_segments=$(awk -F/ '{print NF}' <<< "${CONFIG_DIR}")
  defaults_segments=$(awk -F/ '{print NF}' <<< "${DEFAULTS_DIR}")
  local config_depth=$((2 + config_segments))
  local defaults_depth=$((2 + defaults_segments))

  # Find directories matching either CONFIG_DIR or DEFAULTS_DIR suffix.
  local hits=""
  hits+=$(find "${BRANCHOUT_ROOT}" -mindepth "${config_depth}" -maxdepth "${config_depth}" -type d -path "*/${CONFIG_DIR}" 2>/dev/null)
  if [[ -n "${hits}" ]]; then
    hits+=$'\n'
  fi
  hits+=$(find "${BRANCHOUT_ROOT}" -mindepth "${defaults_depth}" -maxdepth "${defaults_depth}" -type d -path "*/${DEFAULTS_DIR}" 2>/dev/null)

  if [[ -z "${hits}" ]]; then
    echo ""
    echo "No projects found with ${CONFIG_DIR} or ${DEFAULTS_DIR}"
    exit 0
  fi

  # Strip the matched suffix to get project root
  local project_roots=()
  local seen="|"
  local line root
  while IFS= read -r line; do
    [[ -z "${line}" ]] && continue
    if [[ "${line}" == */"${CONFIG_DIR}" ]]; then
      root="${line%/"${CONFIG_DIR}"}"
    elif [[ "${line}" == */"${DEFAULTS_DIR}" ]]; then
      root="${line%/"${DEFAULTS_DIR}"}"
    else
      continue
    fi
    if [[ "${seen}" != *"|${root}|"* ]]; then
      seen+="${root}|"
      project_roots+=("${root}")
    fi
  done <<< "${hits}"

  # Sort project_roots for stable output
  local sorted_roots=()
  while IFS= read -r line; do
    sorted_roots+=("${line}")
  done < <(printf '%s\n' "${project_roots[@]}" | sort)

  echo ""
  echo "Found ${#sorted_roots[@]} project(s) with ${CONFIG_DIR} or ${DEFAULTS_DIR}:"
  echo ""
  local r
  for r in "${sorted_roots[@]}"; do
    echo "  ${r#"${BRANCHOUT_ROOT}/"}"
  done

  local listed=0
  for r in "${sorted_roots[@]}"; do
    echo ""
    list_project "${r}/" "${r#"${BRANCHOUT_ROOT}/"}"
    listed=$((listed + 1))
  done

  echo ""
  echo "Done. Listed ${listed} project(s)."
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --dir)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --dir requires a value" >&2
        usage
        exit 1
      fi
      CONFIG_DIR="$2"
      CONFIG_DIR_EXPLICIT=true
      shift 2
      ;;
    --defaults-dir)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --defaults-dir requires a value" >&2
        usage
        exit 1
      fi
      DEFAULTS_DIR="$2"
      DEFAULTS_DIR_EXPLICIT=true
      shift 2
      ;;
    --all)
      ALL_PROJECTS=true
      shift
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# Reject absolute paths
if [[ "${CONFIG_DIR}" == /* ]]; then
  echo "ERROR: --dir must be a relative path, i.e. a sub path of this repo" >&2
  exit 1
fi
if [[ "${DEFAULTS_DIR}" == /* ]]; then
  echo "ERROR: --defaults-dir must be a relative path, i.e. a sub path of this repo" >&2
  exit 1
fi

if [[ "${ALL_PROJECTS}" == "true" ]]; then
  list_all_projects
else
  # Explicit-flag missing-dir validation
  if [[ "${CONFIG_DIR_EXPLICIT}" == "true" && ! -d "${CONFIG_DIR}" ]]; then
    echo "ERROR: Config directory not found: ${CONFIG_DIR}" >&2
    exit 1
  fi
  if [[ "${DEFAULTS_DIR_EXPLICIT}" == "true" && ! -d "${DEFAULTS_DIR}" ]]; then
    echo "ERROR: Defaults directory not found: ${DEFAULTS_DIR}" >&2
    exit 1
  fi

  if ! list_project ""; then
    echo "ERROR: Neither ${CONFIG_DIR} nor ${DEFAULTS_DIR} exists" >&2
    exit 1
  fi
fi
