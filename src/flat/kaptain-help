# Kaptain CLI help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If arguments given, delegate to that command's --help
if [[ $# -gt 0 ]]; then
  target="kaptain"
  for arg in "$@"; do
    target="${target}-${arg}"
  done
  target_script="${SCRIPT_DIR}/${target}"
  if [[ -x "${target_script}" ]]; then
    exec "${target_script}" --help
  else
    echo "ERROR: Unknown command: $*" >&2
    echo "Run 'kaptain help' for available commands." >&2
    exit 1
  fi
fi

# Command descriptions - add entries here as new commands are created
# Commands without entries get listed with no description
# Commands deliberately excluded from the map get no description (e.g., 42)
describe_command() {
  local cmd="$1"
  case "${cmd}" in
    help)                   echo "Show this help message" ;;
    list)                   echo "List project files and status" ;;
    clean)                  echo "Clean up input/output temporary files" ;;
    keygen)                 echo "Generate encryption keys" ;;
    encrypt)                echo "Encrypt secrets in a directory" ;;
    decrypt)                echo "Decrypt secrets in a directory" ;;
    rotate-key-for-secrets) echo "Rotate encryption key for secrets" ;;
    normalise)              echo "Normalise config files (strip stray trailing newlines)" ;;
    build)                  echo "Build a kaptain project locally" ;;
    run)                    echo "Run the image from the most recent build" ;;
    clean-project)          echo "Clean build output directories" ;;
    clean-images)           echo "Remove PRERELEASE-tagged container images" ;;
    list-images)            echo "List container images filtered by scope and tag class" ;;
    update)                 echo "Update whatever comes after this" ;;
    setup)                  echo "Interactive workstation setup" ;;
    *)                      echo "" ;;
  esac
}

# Check if a script is a sub-command of another script
# e.g., kaptain-list-secrets is a sub-command of kaptain-list
# Walks prefix segments: kaptain-a-b-c checks kaptain-a-b, kaptain-a
is_subcommand() {
  local name="$1"
  local prefix="${name%-*}"
  while [[ "${prefix}" != "kaptain" ]]; do
    if [[ -x "${SCRIPT_DIR}/${prefix}" ]]; then
      return 0
    fi
    prefix="${prefix%-*}"
  done
  return 1
}

cat <<'EOF'
Kaptain CLI - User scripts for Kaptain Kubernetes build and deployment system.

Usage: kaptain <command> [options]

Commands:
EOF

# Collect top-level commands
commands=()
for cmd in "${SCRIPT_DIR}"/kaptain-*; do
  if [[ -x "${cmd}" ]]; then
    name=$(basename "${cmd}")
    if ! is_subcommand "${name}"; then
      commands+=("${name#kaptain-}")
    fi
  fi
done

# Find longest command name
max_len=0
for short in ${commands[@]+"${commands[@]}"}; do
  if [[ ${#short} -gt ${max_len} ]]; then
    max_len=${#short}
  fi
done
pad=$((max_len + 2))

# Print with aligned descriptions
for short in ${commands[@]+"${commands[@]}"}; do
  desc=$(describe_command "${short}")
  if [[ -n "${desc}" ]]; then
    printf "  %-${pad}s %s\n" "${short}" "${desc}"
  else
    echo "  ${short}"
  fi
done
echo

cat <<'EOF'
Utility Commands:
  kaptain list manifests [--dir DIR] [--all]
    List Kubernetes manifest files and their line counts

  kaptain list config [--dir DIR] [--defaults-dir DIR] [--all]
    List config and defaults with key/token-name on the left and value to right
    --dir           Config directory (default: src/config)
    --defaults-dir  Defaults directory (default: src/defaults)

  kaptain list secrets [--dir DIR] [--all] [-v|--verbose]
    List encrypted files and unencrypted raw input and extracted output files

  kaptain clean secrets [--dir DIR] [--all]
    Remove decrypted secret files (.raw, .txt)

  kaptain normalise config [--dir DIR] [--defaults-dir DIR] [--dry-run] [--all]
    Strip the trailing newline from single-line config and defaults files.
    Targets files with exactly one '\n' — the same set flagged as
    "One newline (run kaptain normalise config to strip)" by `kaptain list
    config`. Zero-newline files are already canonical; multi-newline files
    are treated as intentional and left alone.
    --dir           Config directory (default: src/config)
    --defaults-dir  Defaults directory (default: src/defaults)
    --dry-run       Show what would change without writing
    --all           Normalise all projects in branchout tree

  kaptain clean images [--all|--all-same-reg-ns|--prefix=X]
                       [--extra-prefixes=A,B,...]
                       [--include-releases] [--include-prereleases]
                       [--exclude-releases] [--exclude-prereleases] [--dry-run]
    Remove container images whose tag matches the selected classes (default:
    PRERELEASE only), then run image prune.
    --all                 Match every PRERELEASE image on the machine.
                          Forbidden with --include-releases.
    --all-same-reg-ns     Match every image under the current repo's
                          <reg>/<ns>/. Requires a Branchout tree.
    --prefix=X            Match only images under <reg>[/<ns>...] X. Skips
                          the build libs entirely.
    --extra-prefixes=A,B  Comma-separated *additional* <reg>[/<ns>...] prefixes.
                          Composes with --all-same-reg-ns, --prefix=X, or
                          default mode. Mutually exclusive with --all. May
                          not stand alone — use --prefix=X for a single
                          explicit scope.
    --include-releases    Also clean stable (non-PRERELEASE) tags. Forbidden
                          with --all.
    --include-prereleases Default; explicit form is a no-op.
    --exclude-releases    Default; explicit form is a no-op.
    --exclude-prereleases Drop PRERELEASE from the included set. Alone leaves
                          an empty match (rmi skipped, prune still runs).
    --dry-run             Preview only; no rmi, no image prune.
    Default mode and --all-same-reg-ns require
    KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT to be set.

  kaptain list images [--all|--all-same-reg-ns|--prefix=X]
                      [--extra-prefixes=A,B,...]
                      [--include-releases] [--include-prereleases]
                      [--exclude-releases] [--exclude-prereleases]
    List container images filtered by scope and tag class (default: every
    tag in scope). Read-only companion to `clean images`.
    --all                 List every image on the machine.
    --all-same-reg-ns     List every image under the current repo's
                          <reg>/<ns>/. Requires a Branchout tree.
    --prefix=X            List only images under <reg>[/<ns>...] X. Skips
                          the build libs entirely.
    --extra-prefixes=A,B  Comma-separated *additional* <reg>[/<ns>...] prefixes.
                          Composes with --all-same-reg-ns, --prefix=X, or
                          default mode. Mutually exclusive with --all. May
                          not stand alone — use --prefix=X for a single
                          explicit scope.
    --include-releases    Default; explicit form is a no-op.
    --include-prereleases Default; explicit form is a no-op.
    --exclude-releases    List only PRERELEASE tags.
    --exclude-prereleases List only release tags.
    Default mode and --all-same-reg-ns require
    KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT to be set.

Encryption Commands:
  kaptain encrypt [--type TYPE] [--dir DIR]
    Encrypt .raw files to encrypted format.
    --type    Encryption type (age, sha256.aes256, sha256.aes256.10k, etc.)
              Default: age for new dirs, or matches existing encrypted files
    --dir     Target directory (default: src/secrets)

  kaptain decrypt [--type TYPE] [--dir DIR]
    Decrypt encrypted files to .txt files.
    --type    Encryption type (auto-detected from file extensions if omitted)
    --dir     Target directory (default: src/secrets)

  kaptain keygen [--type age|plain] [--output FILE]
    Generate an encryption/decryption key.
    --type    Key type: age (default) or plain
    --output  Write key to file instead of stdout

  kaptain rotate-key-for-secrets [--dir DIR] [--ask-for-key] [--new-type TYPE] [--output FILE]
    Decrypt all secrets with old key and re-encrypt with a new key.
    --ask-for-key  Prompt for new key instead of generating one
    --new-type     Migrate to a different encryption type
    --output       Where to write generated key (default: target/keygen/new.key)

Build Commands:
  kaptain build [--run]
    Build a kaptain project locally.
    Reads KaptainPM.yaml, resolves kind, and delegates to reference build script.
    Requires KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT to be set.
    --run     Run the built image afterwards, as 'kaptain run' does

  kaptain run
    Run the main image from the most recent kaptain build.
    Reads the image URI and container command from the build output, then runs
    the image with --rm. Each port the image exposes is published, from 4242
    upward. The image's own CMD or ENTRYPOINT decides what runs.
    Runs with --init so Ctrl-C stops the container, and interactively when
    stdin and stdout are both terminals. Prints a link per published TCP port,
    for localhost and for each address this machine can be reached on, so the
    app can be opened from Windows under WSL2 or from another machine.

  kaptain clean project [--dir DIR]
    Remove build output directories (kaptain-out/ and kaptainpm/).
    --dir     Output directory to clean (default: kaptain-out)

  kaptain update versions [flags]
    Update version specifications in KaptainPM.yaml files using build-script
    registry/range machinery. Default tightens lower bounds of ranges in
    spec.layers, spec.templates and spec.contents.
    --update-lower-bounds      Default. Tighten range lower bounds.
    --no-update-lower-bounds   Opt out of lower-bound updates.
    --update-fixed             Bump exact refs to absolute highest.
    --update-ranges            Roll ranges across upper bound.
    --api-version              Bump apiVersion to highest schema.
    --update-all               Equivalent to all four update axes.
    --all                      Walk branchout tree, apply to every sibling repo.
    --file FILE                Operate on exactly one file.
    --dry-run                  Preview changes; do not write.
    Requires KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT to be set.

Setup Commands:
  kaptain setup brew [--copy-fred] [--apps-in-home]
    Interactive Homebrew setup for Kaptain users. Walks through suggest-ask-
    remember prompts grouped by purpose (core deps, branchout, build scripts,
    helm, shell tools, container runtime, gh, claude-code, etc.), prints a
    plan, confirms once, then executes. macOS or Linux with brew.
    --copy-fred     Accept defaults for every default-bearing prompt.
    --apps-in-home  Use ~/Applications for cask installs.

Default Override Environment Variables:
  KAPTAIN_USER_SCRIPTS_SECRETS_DIR              Secrets directory (default: src/secrets)
  KAPTAIN_USER_SCRIPTS_CONFIG_DIR               Config directory (default: src/config)
  KAPTAIN_USER_SCRIPTS_DEFAULTS_DIR             Defaults directory (default: src/defaults)
  KAPTAIN_USER_SCRIPTS_MANIFESTS_DIR            Manifests directory (default: src/kubernetes)
  KAPTAIN_USER_SCRIPTS_ENCRYPTION_TYPE          Encryption type (default: age)
  KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT  Build scripts repo location (required for build)
  KAPTAIN_USER_SCRIPTS_OUTPUT_SUB_PATH          Build output directory (default: kaptain-out)

Run 'kaptain help <command>' or 'kaptain <command> --help' for command-specific options.

Direct script access: kaptain-<command>[-<subcommand>]

Use tab completion from `kaptain-` to see what's installed.

EOF

echo "All available kaptain scripts:"
for cmd in "${SCRIPT_DIR}"/kaptain-*; do
  if [[ -x "${cmd}" ]]; then
    echo "  $(basename "${cmd}")"
  fi
done
echo
