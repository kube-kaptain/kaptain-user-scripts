#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Update version specifications inside KaptainPM.yaml files using the
# build-script registry/range machinery.
#
# Default: tighten lower bounds of ranges in spec.layers / spec.templates /
# spec.contents to the highest available version. Opt-in flags broaden the
# scope (fixed bumps, cross-boundary range rolls, apiVersion bump, all four,
# branchout-tree walk).
#
# Run from a Kaptain project repo root, anywhere in a branchout project tree
# with --all, or anywhere with --file FILE).
#
# Usage: kaptain-update-versions [flags]
set -euo pipefail

if [[ -n "${LC_ALL:-}" ]]; then
  export LANG="${LC_ALL}"
  unset LC_ALL
fi
export LC_COLLATE=C
export LC_CTYPE=C.UTF-8
UTF8_PROBE=$'\xc3\xa9'
if [[ ${#UTF8_PROBE} -ne 1 ]]; then
  echo "WARNING: C.UTF-8 locale not available, non-ASCII names will misalign" >&2
fi

UPDATE_LOWER_BOUNDS=true
UPDATE_FIXED=false
UPDATE_RANGES=false
UPDATE_API_VERSION=false
ALL_PROJECTS=false
FILE_OVERRIDE=""
DRY_RUN=false
DEBUG=false

usage() {
  cat <<'EOF'
Usage: kaptain update versions [flags]

Update version specifications inside KaptainPM.yaml files using build-script
machinery. Default tightens lower bounds of ranges in spec.layers, spec.templates
and spec.contents to the highest available release version.

Flags:
  --update-lower-bounds      Default. Tighten lower bound of each range to highest match.
  --no-update-lower-bounds   Opt out of lower-bound updates.
  --update-fixed             Bump exact refs (1.3, [1.2]) to absolute highest.
  --update-ranges            Roll ranges across upper bound when highest >= upper.
  --api-version              Bump apiVersion to highest schema in build scripts.
  --update-all               Equivalent to all four update axes above.
  --all                      Walk branchout tree and apply to every sibling repo.
  --file FILE                Operate on exactly one file (instead of auto-discovery).
  --dry-run                  Preview changes; do not write.
  --debug                    Show inline artifact-resolve error blocks.
  -h, --help                 Show this help.

Requires KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT to be set.
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --update-lower-bounds)
      UPDATE_LOWER_BOUNDS=true
      shift
      ;;
    --no-update-lower-bounds)
      UPDATE_LOWER_BOUNDS=false
      shift
      ;;
    --update-fixed)
      UPDATE_FIXED=true
      shift
      ;;
    --update-ranges)
      UPDATE_RANGES=true
      shift
      ;;
    --api-version)
      UPDATE_API_VERSION=true
      shift
      ;;
    --update-all)
      UPDATE_LOWER_BOUNDS=true
      UPDATE_FIXED=true
      UPDATE_RANGES=true
      UPDATE_API_VERSION=true
      shift
      ;;
    --all)
      ALL_PROJECTS=true
      shift
      ;;
    --file)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --file requires a value" >&2
        usage >&2
        exit 1
      fi
      FILE_OVERRIDE="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --debug)
      DEBUG=true
      shift
      ;;
    *)
      echo "ERROR: Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# --all and --file are mutually exclusive
if [[ "${ALL_PROJECTS}" == "true" && -n "${FILE_OVERRIDE}" ]]; then
  echo "ERROR: --all and --file are mutually exclusive" >&2
  exit 1
fi

# Gate 1: build scripts repo
if [[ -z "${KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT:-}" ]]; then
  echo "ERROR: KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT is not set." >&2
  echo "" >&2
  echo "To use kaptain update versions, clone the build scripts repo and set this variable:" >&2
  echo "" >&2
  echo "  git clone <build-scripts-repo-url>" >&2
  echo "  cd <build-scripts-repo>" >&2
  echo "  git checkout <version>" >&2
  echo "  export KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT=\"\$(pwd)\"" >&2
  exit 1
fi

BUILD_ROOT="${KAPTAIN_USER_SCRIPTS_BUILD_SCRIPTS_REPO_ROOT}"

if [[ ! -d "${BUILD_ROOT}" ]]; then
  echo "ERROR: Build scripts repo root does not exist: ${BUILD_ROOT}" >&2
  exit 1
fi
if [[ ! -d "${BUILD_ROOT}/src/scripts" ]]; then
  echo "ERROR: Build scripts repo missing src/scripts: ${BUILD_ROOT}/src/scripts" >&2
  exit 1
fi
if [[ ! -d "${BUILD_ROOT}/src/schemas" ]]; then
  echo "ERROR: Build scripts repo missing src/schemas: ${BUILD_ROOT}/src/schemas" >&2
  exit 1
fi

# Gate 2: yq
if ! command -v yq &>/dev/null; then
  echo "ERROR: yq is required but not found on PATH" >&2
  exit 1
fi

# Gate 3: artifact-resolve (only needed for axes that hit the registry)
ARTIFACT_RESOLVE="${BUILD_ROOT}/src/scripts/util/artifact-resolve"
if [[ "${UPDATE_LOWER_BOUNDS}" == "true" || "${UPDATE_FIXED}" == "true" || "${UPDATE_RANGES}" == "true" ]]; then
  if [[ ! -x "${ARTIFACT_RESOLVE}" ]]; then
    echo "ERROR: artifact-resolve not found or not executable: ${ARTIFACT_RESOLVE}" >&2
    exit 1
  fi
fi

# Stub log functions so libraries that expect log_error / log_warning / log
# (detect-build-context, version-range) work standalone.
if ! declare -f log_error >/dev/null 2>&1; then
  log_error() { echo "ERROR: $*" >&2; }
fi
if ! declare -f log_warning >/dev/null 2>&1; then
  log_warning() { echo "WARN: $*" >&2; }
fi
if ! declare -f log >/dev/null 2>&1; then
  log() { echo "$*" >&2; }
fi

# Pre-yaml build context (BUILD_PLATFORM=local, registry/namespace, branches,
# repo identity). artifact-resolve needs BUILD_PLATFORM at minimum and the
# DOCKER_TARGET_* pair for short-form refs. All vars overridable via env.
DETECT_BUILD_CONTEXT_LIB="${BUILD_ROOT}/src/scripts/lib/detect-build-context.bash"
if [[ ! -f "${DETECT_BUILD_CONTEXT_LIB}" ]]; then
  echo "ERROR: detect-build-context library not found: ${DETECT_BUILD_CONTEXT_LIB}" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "${DETECT_BUILD_CONTEXT_LIB}"

# IMAGE_BUILD_COMMAND is set by validate-tooling in a normal build; it's not
# part of detect-build-context. Pick docker or podman ourselves.
if [[ -z "${IMAGE_BUILD_COMMAND:-}" ]]; then
  if command -v docker &>/dev/null; then
    export IMAGE_BUILD_COMMAND="docker"
  elif command -v podman &>/dev/null; then
    export IMAGE_BUILD_COMMAND="podman"
  fi
fi

# Source version-range library — provides version_compare/_ge/_gt/_le/_lt,
# version_is_exact, version_unwrap_exact, version_filter_release,
# version_resolve_range.
VERSION_RANGE_LIB="${BUILD_ROOT}/src/scripts/lib/version-range.bash"
if [[ ! -f "${VERSION_RANGE_LIB}" ]]; then
  echo "ERROR: version-range library not found: ${VERSION_RANGE_LIB}" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "${VERSION_RANGE_LIB}"

# -----------------------------------------------------------------------------
# Discovery
# -----------------------------------------------------------------------------

# Find branchout root by walking up from cwd. Mirrors the pattern used by
# kaptain-list-secrets / kaptain-list-config / etc.
find_branchout_root() {
  local dir="${PWD}"
  BRANCHOUT_PROJECTS_DIRECTORY="${BRANCHOUT_PROJECTS_DIRECTORY:-projects}"
  # shellcheck disable=SC1090,SC1091  # user config path, not resolvable at lint time
  test -f ~/.config/branchoutrc && source ~/.config/branchoutrc
  local home_projects="${HOME}/${BRANCHOUT_PROJECTS_DIRECTORY}"

  if [[ "${dir}" != "${home_projects}/"* ]]; then
    echo "ERROR: Not under ${home_projects}/, cannot find branchout tree" >&2
    echo "ERROR: Cannot perform --all version update without a valid structure" >&2
    exit 1
  fi

  while [[ "${dir}" != "${home_projects}" && "${dir}" != "/" ]]; do
    if [[ -f "${dir}/Branchoutfile" && -f "${dir}/Branchoutprojects" ]]; then
      BRANCHOUT_ROOT="${dir}"
      return 0
    fi
    dir=$(dirname "${dir}")
  done

  echo "ERROR: Branchout root not found" >&2
  echo "ERROR: Cannot perform --all version update without a valid structure" >&2
  exit 1
}

# Discover all KaptainPM.yaml files at the three known locations under a
# single project root. Appends matches to TARGET_FILES.
discover_in_project() {
  local root="$1"
  local candidate
  for candidate in \
    "${root}/KaptainPM.yaml" \
    "${root}/src/layer/KaptainPM.yaml" \
    "${root}/src/layerset/KaptainPM.yaml"; do
    if [[ -f "${candidate}" ]]; then
      TARGET_FILES+=("${candidate}")
    fi
  done
}

TARGET_FILES=()
if [[ -n "${FILE_OVERRIDE}" ]]; then
  if [[ ! -f "${FILE_OVERRIDE}" ]]; then
    echo "ERROR: --file not found: ${FILE_OVERRIDE}" >&2
    exit 1
  fi
  TARGET_FILES+=("${FILE_OVERRIDE}")
elif [[ "${ALL_PROJECTS}" == "true" ]]; then
  find_branchout_root
  echo "Found branchout root: ${BRANCHOUT_ROOT}"
  # Project dirs are at depth 2 (group/group-project) under the branchout root.
  while IFS= read -r -d '' project_dir; do
    discover_in_project "${project_dir}"
  done < <(find "${BRANCHOUT_ROOT}" -mindepth 2 -maxdepth 2 -type d -print0 2>/dev/null | sort -z)
else
  discover_in_project "."
fi

if [[ ${#TARGET_FILES[@]} -eq 0 ]]; then
  if [[ "${ALL_PROJECTS}" == "true" ]]; then
    echo "No KaptainPM.yaml files found under branchout root" >&2
  elif [[ -n "${FILE_OVERRIDE}" ]]; then
    echo "ERROR: --file not found: ${FILE_OVERRIDE}" >&2
  else
    echo "ERROR: No KaptainPM.yaml found at any of: KaptainPM.yaml, src/layer/KaptainPM.yaml, src/layerset/KaptainPM.yaml" >&2
  fi
  exit 1
fi

# -----------------------------------------------------------------------------
# Version / range helpers
# -----------------------------------------------------------------------------

# Split a ref of the form [provider|][prefix/]name:version-or-range into
# REF_NAME (everything up to the last colon) and REF_VERSION (after).
# Sets REF_NAME and REF_VERSION.
split_ref() {
  local ref="$1"
  REF_NAME="${ref%:*}"
  REF_VERSION="${ref##*:}"
}

# Return the number of dot-separated segments in a version string.
segment_depth() {
  local v="$1"
  local -a parts
  IFS='.' read -ra parts <<< "${v}"
  echo "${#parts[@]}"
}

# Truncate or pad version v to the requested segment depth.
truncate_pad() {
  local v="$1"
  local depth="$2"
  local -a parts
  IFS='.' read -ra parts <<< "${v}"
  local i out=""
  for ((i = 0; i < depth; i++)); do
    local seg="${parts[i]:-0}"
    if [[ -z "${out}" ]]; then
      out="${seg}"
    else
      out="${out}.${seg}"
    fi
  done
  echo "${out}"
}

# Find the rightmost non-zero segment index of v. Zero-only versions return 0.
rightmost_nonzero_segment() {
  local v="$1"
  local -a parts
  IFS='.' read -ra parts <<< "${v}"
  local i level=0
  for ((i = 0; i < ${#parts[@]}; i++)); do
    if [[ "${parts[i]}" != "0" ]]; then
      level="${i}"
    fi
  done
  echo "${level}"
}

# Increment the segment of v at `level` by 1, zero everything after, then
# truncate/pad to `depth`.
bump_segment_to_depth() {
  local v="$1"
  local level="$2"
  local depth="$3"
  local -a parts
  IFS='.' read -ra parts <<< "${v}"
  local i out=""
  for ((i = 0; i < depth; i++)); do
    local seg
    if (( i < level )); then
      seg="${parts[i]:-0}"
    elif (( i == level )); then
      seg=$(( ${parts[i]:-0} + 1 ))
    else
      seg=0
    fi
    if [[ -z "${out}" ]]; then
      out="${seg}"
    else
      out="${out}.${seg}"
    fi
  done
  echo "${out}"
}

# Parse a range into LOWER_BRACKET, LOWER_VERSION, UPPER_VERSION,
# UPPER_BRACKET. Returns 0 if range, 1 if not a range.
parse_range() {
  local r="$1"
  if version_is_exact "${r}"; then
    return 1
  fi
  LOWER_BRACKET="${r:0:1}"
  UPPER_BRACKET="${r: -1}"
  local inner="${r:1:${#r}-2}"
  LOWER_VERSION="${inner%%,*}"
  UPPER_VERSION="${inner#*,}"
  LOWER_VERSION="${LOWER_VERSION// /}"
  UPPER_VERSION="${UPPER_VERSION// /}"
  return 0
}

# Reassemble a range string from its parts.
assemble_range() {
  local lb="$1" lv="$2" uv="$3" ub="$4"
  echo "${lb}${lv},${uv}${ub}"
}

# -----------------------------------------------------------------------------
# Registry resolution
# -----------------------------------------------------------------------------

RESOLVE_TMPDIR="$(mktemp -d -t kaptain-update-versions.XXXXXX)"
trap 'rm -rf "${RESOLVE_TMPDIR}"' EXIT

# Per-section artifact variant suffix passed to artifact-resolve. The docker
# provider uses this to filter remote tags to `*-<variant>` multi-arch indices
# (e.g. `1.7.1.2-manifests`), strip the suffix for range matching, then
# reconstruct the resolved URI with the suffix re-appended. Set by
# process_file before iterating each section; empty for plain image refs.
RESOLVE_VARIANT=""

# Resolve a single ref against the registry. IS_RELEASE=true so prereleases
# are filtered. Sets RESOLVED_VERSION (the version part minus any variant).
# Returns 0 on success, 1 if artifact-resolve failed.
resolve_to_version() {
  local ref="$1"
  local safe="${ref//[^a-zA-Z0-9._-]/_}"
  local out="${RESOLVE_TMPDIR}/${safe}"
  local err="${RESOLVE_TMPDIR}/${safe}.err"
  rm -f "${out}" "${err}"
  RESOLVE_ERR_FILE="${err}"
  RESOLVED_VERSION=""
  if ! IS_RELEASE=true "${ARTIFACT_RESOLVE}" "${ref}" "${out}" "${RESOLVE_VARIANT}" >"${err}" 2>&1; then
    return 1
  fi
  local resolved
  resolved="$(<"${out}")"
  local version="${resolved##*:}"
  # Strip the variant suffix the provider re-appended so callers compare
  # canonical numeric versions.
  if [[ -n "${RESOLVE_VARIANT}" && "${version}" == *"-${RESOLVE_VARIANT}" ]]; then
    version="${version%"-${RESOLVE_VARIANT}"}"
  fi
  RESOLVED_VERSION="${version}"
  return 0
}

# Resolve a ref's name@absolute-highest using a wildcard range.
# Sets HIGHEST_VERSION.
resolve_highest() {
  local name="$1"
  HIGHEST_VERSION=""
  # `[0,)` matches every numeric version. IS_RELEASE filters prereleases out.
  resolve_to_version "${name}:[0,)" || return 1
  HIGHEST_VERSION="${RESOLVED_VERSION:-}"
  [[ -n "${HIGHEST_VERSION}" ]]
}

# Resolve a ref's existing range/exact to the matching highest.
# Sets MATCH_VERSION (the version inside the range).
resolve_match() {
  local ref="$1"
  MATCH_VERSION=""
  resolve_to_version "${ref}" || return 1
  MATCH_VERSION="${RESOLVED_VERSION:-}"
  [[ -n "${MATCH_VERSION}" ]]
}

# -----------------------------------------------------------------------------
# Range-update algorithm
# -----------------------------------------------------------------------------

# Apply the --update-ranges algorithm. Sets NEW_RANGE on success.
# Falls back to lower-bound tighten when H is inside the existing upper.
compute_updated_range() {
  local range="$1" highest="$2"
  parse_range "${range}" || return 1

  local new_lower new_upper
  if [[ -z "${UPPER_VERSION}" ]]; then
    # No upper: leave upper open, lift lower if needed.
    if [[ -z "${LOWER_VERSION}" ]]; then
      # Both empty (rare): leave alone.
      return 1
    fi
    local ldepth
    ldepth="$(segment_depth "${LOWER_VERSION}")"
    new_lower="$(truncate_pad "${highest}" "${ldepth}")"
    NEW_RANGE="$(assemble_range "${LOWER_BRACKET}" "${new_lower}" "" "${UPPER_BRACKET}")"
    return 0
  fi

  # Decide if H is inside the existing upper.
  local in_range=false
  if version_lt "${highest}" "${UPPER_VERSION}"; then
    in_range=true
  fi

  local udepth
  udepth="$(segment_depth "${UPPER_VERSION}")"

  if [[ "${in_range}" == "true" ]]; then
    # Tighten lower only; upper unchanged.
    if [[ -z "${LOWER_VERSION}" ]]; then
      # No lower to lift: leave alone.
      return 1
    fi
    local ldepth
    ldepth="$(segment_depth "${LOWER_VERSION}")"
    new_lower="$(truncate_pad "${highest}" "${ldepth}")"
    NEW_RANGE="$(assemble_range "${LOWER_BRACKET}" "${new_lower}" "${UPPER_VERSION}" "${UPPER_BRACKET}")"
    return 0
  fi

  # H >= upper: bump upper segment at U's bound level.
  local level
  level="$(rightmost_nonzero_segment "${UPPER_VERSION}")"
  new_upper="$(bump_segment_to_depth "${highest}" "${level}" "${udepth}")"

  if [[ -z "${LOWER_VERSION}" ]]; then
    new_lower=""
  else
    local ldepth
    ldepth="$(segment_depth "${LOWER_VERSION}")"
    new_lower="$(truncate_pad "${highest}" "${ldepth}")"
  fi

  NEW_RANGE="$(assemble_range "${LOWER_BRACKET}" "${new_lower}" "${new_upper}" "${UPPER_BRACKET}")"
  return 0
}

# Tighten only the lower bound of a range. Sets NEW_RANGE.
compute_tightened_lower() {
  local range="$1" highest="$2"
  parse_range "${range}" || return 1
  if [[ -z "${LOWER_VERSION}" ]]; then
    return 1
  fi
  if ! version_gt "${highest}" "${LOWER_VERSION}"; then
    return 1
  fi
  local ldepth new_lower
  ldepth="$(segment_depth "${LOWER_VERSION}")"
  new_lower="$(truncate_pad "${highest}" "${ldepth}")"
  NEW_RANGE="$(assemble_range "${LOWER_BRACKET}" "${new_lower}" "${UPPER_VERSION}" "${UPPER_BRACKET}")"
  return 0
}

# -----------------------------------------------------------------------------
# Per-entry processing
# -----------------------------------------------------------------------------

# Accumulators.
#   CHANGES drives the apply step. Each entry is "${file}|${location}|${before}|${after}".
#   ROWS drives output rendering. Each entry is "${status}|${file}|${location}|${ref}|${detail}"
#   where status is one of: CHANGE / KEEP / SKIP / ERROR / INVALID.
CHANGES=()
ROWS=()

# Widest short-location string ("layers[N]" / "templates[N]" / "contents[N]" /
# "apiVersion") across the entire run, computed once before processing. Used to
# align the streaming output in non-debug mode so the status column starts at
# the same column for every file.
MAX_LOC_WIDTH=0

# Widest status label (CHANGE/KEEP/SKIP/ERROR/INVALID). INVALID is the longest
# at 7 chars. Kept as a constant rather than hard-coded at the printf so changes
# to the label set only need to update this one place.
STATUS_WIDTH=7

# Scan every target file and find the widest short-location string we might
# emit. Section names are static; the only variable is the index width, which
# we derive from the per-section entry count.
compute_max_loc_width() {
  local file section count last_idx digits len
  MAX_LOC_WIDTH=0
  for file in "${TARGET_FILES[@]}"; do
    if [[ "${UPDATE_LOWER_BOUNDS}" == "true" || "${UPDATE_FIXED}" == "true" || "${UPDATE_RANGES}" == "true" ]]; then
      for section in layers templates contents; do
        count="$(yq -r ".spec.${section} // [] | length" "${file}")"
        if [[ "${count}" -eq 0 ]]; then
          continue
        fi
        last_idx=$((count - 1))
        digits=${#last_idx}
        len=$(( ${#section} + 2 + digits ))
        if (( len > MAX_LOC_WIDTH )); then MAX_LOC_WIDTH=$len; fi
      done
    fi
    if [[ "${UPDATE_API_VERSION}" == "true" ]]; then
      if (( 10 > MAX_LOC_WIDTH )); then MAX_LOC_WIDTH=10; fi
    fi
  done
}

# Push a row for output. Args: status, file, location, ref, detail.
# In non-debug mode the row also streams to stdout immediately so users see
# progress in real time. In --debug mode rows are accumulated and rendered as
# an aligned per-file table by render_rows_slice.
add_row() {
  ROWS+=("${1}|${2}|${3}|${4}|${5}")
  if [[ "${DEBUG}" != "true" ]]; then
    printf '%-*s  %-*s  %s\n' "${MAX_LOC_WIDTH}" "${3#spec.}" "${STATUS_WIDTH}" "${1}" "${5}"
  fi
}

# Push a change row for both arrays. Args: file, location, before, after.
# Detail column shape:
#   image refs   → "<name>, <oldVer> → <newVer>"  (name = ref up to last `:`)
#   apiVersion   → "<oldValue> → <newValue>"      (no `:` to split on)
add_change() {
  local file="$1" location="$2" before="$3" after="$4"
  CHANGES+=("${file}|${location}|${before}|${after}")
  local detail
  if [[ "${location}" == "apiVersion" ]]; then
    detail="${before} → ${after}"
  else
    detail="${before%:*}, ${before##*:} → ${after##*:}"
  fi
  add_row "CHANGE" "${file}" "${location}" "${before}" "${detail}"
}

# Print the inline artifact-resolve error block to stderr (only in --debug),
# track that an error occurred, and push an ERROR row.
ERRORS_PRESENT=false
record_resolve_error() {
  local file="$1" location="$2" ref="$3"
  ERRORS_PRESENT=true
  local detail_suffix
  if [[ "${DEBUG}" == "true" ]]; then
    echo "----- Error: artifact-resolve failed for ${ref} (${file} ${location}) -----" >&2
    [[ -s "${RESOLVE_ERR_FILE:-}" ]] && cat "${RESOLVE_ERR_FILE}" >&2
    echo "----- Error otuput ends -----" >&2
    echo "" >&2
    detail_suffix="see error above"
  else
    detail_suffix="use --debug to see the output"
  fi
  add_row "ERROR" "${file}" "${location}" "${ref}" "${ref}, artifact-resolve failed (${detail_suffix})"
}

# Push an INVALID row: the registry answered and nothing it has satisfies the
# ref in the file. Distinct from ERROR, which means we could not get an answer
# at all. An ERROR may clear on a re-run; an INVALID needs the file edited.
INVALIDS_PRESENT=false
record_invalid() {
  local file="$1" location="$2" ref="$3" detail="$4"
  INVALIDS_PRESENT=true
  add_row "INVALID" "${file}" "${location}" "${ref}" "${ref}, ${detail}"
}

# Classify a failed resolve. Ask for the artifact's absolute highest: if that
# resolves, the artifact is published and it is the ref that cannot be
# satisfied (INVALID); if it fails too, we genuinely could not ask (ERROR).
# resolve_highest overwrites RESOLVE_ERR_FILE, so the original failure's error
# file is saved and put back for record_resolve_error's --debug block.
record_resolve_failure() {
  local file="$1" location="$2" ref="$3" name="$4"
  local original_err="${RESOLVE_ERR_FILE:-}"
  if resolve_highest "${name}"; then
    record_invalid "${file}" "${location}" "${ref}" \
      "no version matches, ${HIGHEST_VERSION} is the highest available"
    return 0
  fi
  RESOLVE_ERR_FILE="${original_err}"
  record_resolve_error "${file}" "${location}" "${ref}"
}

# Process one entry. Decides which axis applies, records a row for every
# disposition (change / keep / skip / invalid / error).
# Arguments: file, location, full_ref
process_entry() {
  local file="$1" location="$2" ref="$3"
  split_ref "${ref}"
  local name="${REF_NAME}" version="${REF_VERSION}"

  if [[ "${version}" == *-PRERELEASE* ]]; then
    add_row "SKIP" "${file}" "${location}" "${ref}" "${ref}, PRERELEASE references are local-only and not updated"
    return 0
  fi

  if version_is_exact "${version}"; then
    if [[ "${UPDATE_FIXED}" != "true" ]]; then
      add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, exact ref (pass --update-fixed to bump)"
      return 0
    fi
    # Determine bracket style to preserve [N] vs N
    local bracketed=false
    local plain
    plain="$(version_unwrap_exact "${version}")"
    if [[ "${version}" != "${plain}" ]]; then
      bracketed=true
    fi
    if ! resolve_highest "${name}"; then
      record_resolve_error "${file}" "${location}" "${ref}"
      return 0
    fi
    # The file names a version the registry does not have. version_resolve_range
    # trusts exact refs without an existence check, so without this the row would
    # fall through to KEEP and claim "already at highest" against a lower number.
    if version_gt "${plain}" "${HIGHEST_VERSION}"; then
      record_invalid "${file}" "${location}" "${ref}" \
        "${HIGHEST_VERSION} is the highest available"
      return 0
    fi
    if ! version_gt "${HIGHEST_VERSION}" "${plain}"; then
      add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, already at highest (${HIGHEST_VERSION})"
      return 0
    fi
    local target_depth
    target_depth="$(segment_depth "${plain}")"
    local new_plain
    new_plain="$(truncate_pad "${HIGHEST_VERSION}" "${target_depth}")"
    local new_version
    if [[ "${bracketed}" == "true" ]]; then
      new_version="[${new_plain}]"
    else
      new_version="${new_plain}"
    fi
    local new_ref="${name}:${new_version}"
    if [[ "${new_ref}" != "${ref}" ]]; then
      add_change "${file}" "${location}" "${ref}" "${new_ref}"
    else
      add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, already at highest (${HIGHEST_VERSION})"
    fi
    return 0
  fi

  # It's a range.
  if [[ "${UPDATE_RANGES}" == "true" ]]; then
    # resolve_highest is already the widest possible query, so a failure here
    # cannot be an unsatisfiable ref; it is always a real resolve failure.
    if ! resolve_highest "${name}"; then
      record_resolve_error "${file}" "${location}" "${ref}"
      return 0
    fi
    # Nothing in the registry reaches the lower bound. Checked before
    # compute_updated_range, which would otherwise tighten the lower bound
    # downwards onto the highest available and write a silent downgrade.
    if parse_range "${version}" && [[ -n "${LOWER_VERSION}" ]] &&
       version_gt "${LOWER_VERSION}" "${HIGHEST_VERSION}"; then
      record_invalid "${file}" "${location}" "${ref}" \
        "${HIGHEST_VERSION} is the highest available"
      return 0
    fi
    if compute_updated_range "${version}" "${HIGHEST_VERSION}"; then
      local new_ref="${name}:${NEW_RANGE}"
      if [[ "${new_ref}" != "${ref}" ]]; then
        add_change "${file}" "${location}" "${ref}" "${new_ref}"
      else
        add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, range already covers highest (${HIGHEST_VERSION})"
      fi
    else
      add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, open range, nothing to tighten (highest ${HIGHEST_VERSION})"
    fi
    return 0
  fi

  if [[ "${UPDATE_LOWER_BOUNDS}" == "true" ]]; then
    # Resolve the range to its current highest match; that's our new lower.
    # A failure here can mean the range matches nothing published rather than a
    # broken resolve, so let record_resolve_failure tell the two apart.
    if ! resolve_match "${ref}"; then
      record_resolve_failure "${file}" "${location}" "${ref}" "${name}"
      return 0
    fi
    if compute_tightened_lower "${version}" "${MATCH_VERSION}"; then
      local new_ref="${name}:${NEW_RANGE}"
      if [[ "${new_ref}" != "${ref}" ]]; then
        add_change "${file}" "${location}" "${ref}" "${new_ref}"
      else
        add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, lower already at highest match (${MATCH_VERSION})"
      fi
    else
      add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, lower already at highest match (${MATCH_VERSION})"
    fi
    return 0
  fi

  # No axis enabled for this kind of ref.
  add_row "KEEP" "${file}" "${location}" "${ref}" "${ref}, no update axis enabled for this ref"
}

# -----------------------------------------------------------------------------
# apiVersion discovery
# -----------------------------------------------------------------------------

# Read the schema version directly from BUILD_ROOT/src/schemas/version.
# Sets CURRENT_API_VERSION. Exits hard if the file is missing or empty.
read_schema_version() {
  local version_file="${BUILD_ROOT}/src/schemas/version"
  if [[ ! -f "${version_file}" ]]; then
    echo "ERROR: Schema version file not found: ${version_file}" >&2
    exit 1
  fi
  CURRENT_API_VERSION="$(tr -d '[:space:]' < "${version_file}")"
  if [[ -z "${CURRENT_API_VERSION}" ]]; then
    echo "ERROR: Schema version file is empty: ${version_file}" >&2
    exit 1
  fi
}

# -----------------------------------------------------------------------------
# File processing
# -----------------------------------------------------------------------------

process_file() {
  local file="$1"

  if [[ "${UPDATE_LOWER_BOUNDS}" == "true" || "${UPDATE_FIXED}" == "true" || "${UPDATE_RANGES}" == "true" ]]; then
    local section
    for section in layers templates contents; do
      local count
      count="$(yq -r ".spec.${section} // [] | length" "${file}")"
      if [[ "${count}" -eq 0 ]]; then
        continue
      fi
      # spec.templates and spec.contents resolve through the manifests
      # multi-arch index variant (matching the layer-package / content-resolve
      # pipeline in buildon). spec.layers refs are plain image refs.
      case "${section}" in
        templates|contents) RESOLVE_VARIANT="manifests" ;;
        *)                  RESOLVE_VARIANT="" ;;
      esac
      local i
      for ((i = 0; i < count; i++)); do
        local entry
        entry="$(yq -r ".spec.${section}[${i}]" "${file}")"
        process_entry "${file}" "spec.${section}[${i}]" "${entry}"
      done
    done
    RESOLVE_VARIANT=""
  fi

  if [[ "${UPDATE_API_VERSION}" == "true" ]]; then
    local current
    current="$(yq -r '.apiVersion // ""' "${file}")"
    if [[ -z "${current}" ]]; then
      add_row "SKIP" "${file}" "apiVersion" "(missing)" "(missing), no apiVersion field in file"
    elif [[ "${current}" != kaptain.org/* ]]; then
      add_row "SKIP" "${file}" "apiVersion" "${current}" "${current}, not a kaptain.org/ apiVersion"
    else
      local current_ver="${current#kaptain.org/}"
      local target="kaptain.org/${CURRENT_API_VERSION}"
      if version_gt "${current_ver}" "${CURRENT_API_VERSION}"; then
        record_invalid "${file}" "apiVersion" "${current}" \
          "${CURRENT_API_VERSION} is the highest schema version"
      elif version_gt "${CURRENT_API_VERSION}" "${current_ver}"; then
        add_change "${file}" "apiVersion" "${current}" "${target}"
      else
        add_row "KEEP" "${file}" "apiVersion" "${current}" "${current}, already at schema version (${CURRENT_API_VERSION})"
      fi
    fi
  fi
}

if [[ "${UPDATE_API_VERSION}" == "true" ]]; then
  read_schema_version
fi

# -----------------------------------------------------------------------------
# Output (streamed per file)
# -----------------------------------------------------------------------------

# Render rows added to ROWS during a single process_file call. Three columns:
# short-location (no leading `spec.`), status, disposition detail. Column
# widths are computed per file, so each block is self-contained.
short_location() {
  local loc="$1"
  printf '%s' "${loc#spec.}"
}

render_rows_slice() {
  local from="$1" to="$2"
  local i row s l d local_short
  local w_loc=0 w_status=0

  # First pass: column widths over this slice.
  for ((i = from; i < to; i++)); do
    row="${ROWS[$i]}"
    IFS='|' read -r s _ l _ _ <<< "${row}"
    local_short="${l#spec.}"
    if (( ${#local_short} > w_loc )); then w_loc="${#local_short}"; fi
    if (( ${#s} > w_status )); then w_status="${#s}"; fi
  done

  local fmt
  printf -v fmt '%%-%ds  %%-%ds  %%s\n' "${w_loc}" "${w_status}"

  # Second pass: render.
  for ((i = from; i < to; i++)); do
    row="${ROWS[$i]}"
    IFS='|' read -r s _ l _ d <<< "${row}"
    # shellcheck disable=SC2059
    printf "${fmt}" "${l#spec.}" "${s}" "${d}"
  done
}

# yq's in-place write reserialises the whole document and drops blank lines
# (YAML has no data model for them; comments are kept). Reinstate them from the
# pre-write snapshot: yq preserves the count and order of non-blank lines, so we
# walk the snapshot's blank/non-blank pattern and splice yq's updated non-blank
# lines back into it. If the non-blank counts diverge (yq reflowed a scalar) we
# leave yq's output untouched rather than risk mangling the file.
restore_blank_lines() {
  local snapshot="$1" rewritten="$2"
  local tmp
  tmp="$(mktemp)"
  if awk -v snap="${snapshot}" '
    { R[NR] = $0 }
    END {
      rn = 0
      for (k = 1; k <= NR; k++)
        if (R[k] !~ /^[[:space:]]*$/) NB[++rn] = R[k]
      on = 0; ol = 0
      while ((getline line < snap) > 0) {
        OL[++ol] = line
        if (line !~ /^[[:space:]]*$/) on++
      }
      close(snap)
      if (on != rn) exit 3
      j = 0
      for (k = 1; k <= ol; k++) {
        if (OL[k] ~ /^[[:space:]]*$/) print ""
        else print NB[++j]
      }
    }
  ' "${rewritten}" > "${tmp}"; then
    mv "${tmp}" "${rewritten}"
  else
    rm -f "${tmp}"
  fi
}

compute_max_loc_width

# Header up front so users see what's about to happen, then process and render
# each file in turn. Errors written to stderr by record_resolve_error stream
# inline between the "Processing" log and the file's table.
if [[ ${#TARGET_FILES[@]} -eq 1 ]]; then
  echo "Found 1 file to check and potentially update:"
else
  echo "Found ${#TARGET_FILES[@]} files to check and potentially update:"
fi
for tf in "${TARGET_FILES[@]}"; do
  echo " * ${tf}"
done
echo ""

for file in "${TARGET_FILES[@]}"; do
  echo "Processing ${file}:"
  rows_before=${#ROWS[@]}
  process_file "${file}"
  rows_after=${#ROWS[@]}
  if [[ "${DEBUG}" == "true" ]] && (( rows_after > rows_before )); then
    render_rows_slice "${rows_before}" "${rows_after}"
  fi
  echo ""
done

CHANGES_COUNT=${#CHANGES[@]}

# Apply changes (unless dry-run)
if [[ "${DRY_RUN}" != "true" && ${CHANGES_COUNT} -gt 0 ]]; then
  # Track unique files via a delimited string — empty-array indexing under
  # `set -u` on Bash 3.2 is unsafe.
  files_seen=""
  files_count=0
  # Snapshot each file before yq touches it so we can restore its blank-line
  # layout afterwards (yq drops blank lines on write).
  snap_dir="$(mktemp -d)"
  for row in "${CHANGES[@]}"; do
    IFS='|' read -r f l _ a <<< "${row}"
    if [[ "|${files_seen}|" != *"|${f}|"* ]]; then
      files_seen="${files_seen:+${files_seen}|}${f}"
      files_count=$((files_count + 1))
      cp "${f}" "${snap_dir}/snap_${files_count}"
    fi
    if [[ "${l}" == "apiVersion" ]]; then
      yq eval -i ".apiVersion = \"${a}\"" "${f}"
    else
      # location is e.g. spec.layers[0]
      yq eval -i ".${l} = \"${a}\"" "${f}"
    fi
  done
  # Reinstate the blank lines yq dropped, once per unique file (same first-seen
  # order used when snapshotting, so snap_N lines up with the Nth unique file).
  restored_seen=""
  restore_idx=0
  for row in "${CHANGES[@]}"; do
    IFS='|' read -r f _ _ _ <<< "${row}"
    if [[ "|${restored_seen}|" != *"|${f}|"* ]]; then
      restored_seen="${restored_seen:+${restored_seen}|}${f}"
      restore_idx=$((restore_idx + 1))
      restore_blank_lines "${snap_dir}/snap_${restore_idx}" "${f}"
    fi
  done
  rm -rf "${snap_dir}"
  files_list="${files_seen//|/ }"
  echo "${CHANGES_COUNT} change(s) applied across ${files_count} file(s)."
  echo "Review with: git diff ${files_list}"
  echo "Commit with: git add ${files_list} && git commit -m 'Update versions'"
elif [[ ${CHANGES_COUNT} -gt 0 ]]; then
  echo "${CHANGES_COUNT} change(s) would be applied (dry run)."
else
  echo "No changes."
fi

if [[ "${INVALIDS_PRESENT}" == "true" ]]; then
  echo ""
  echo "INVALID references present: these name versions that do not exist and were left alone."
  echo "Re-running will not clear them, edit the file(s) to a version that is available."
fi

if [[ "${ERRORS_PRESENT}" == "true" && "${DEBUG}" != "true" ]]; then
  echo ""
  echo "ERRORS present, please run again with --debug to see the output."
fi
